<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cb4"
    android:versionCode="3"
    android:versionName="1.2">

    <!-- Android 8 (API 26) до Android 15 (API 35), arm64/arm32/x86_64 -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <!-- Онлайн-режим ходит в Firebase Realtime Database по HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Рендер работает только через Vulkan: без поддержки 1.0 игра не имеет
         запасного пути, поэтому магазин не должен ставить её на такие устройства. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:required="true" android:version="0x00010000" />
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />

    <application
        android:label="Cubic Battle 4"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="true">

        <activity
            android:name="com.cb4.GameActivity"
            <!-- singleTask: возврат в игру из свёрнутого состояния не должен
                 создавать второй экземпляр NativeActivity. Два native-цикла в
                 одном процессе делят общие глобальные переменные и Vulkan, и
                 это заканчивалось вылетом. -->
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <meta-data
                android:name="android.app.lib_name"
                android:value="ds_game" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
