<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.cb4"
    android:versionCode="7"
    android:versionName="1.2.4">

    <!-- Android 8 (API 26) до Android 15 (API 35), arm64/arm32/x86_64 -->
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />

    <!-- Онлайн-режим ходит в Firebase Realtime Database по HTTPS. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Логи вылетов в /storage/emulated/0/ds_logs (до Android 10 включительно). -->
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- Рендер работает через Vulkan, но с полного отказа запасным путём
         рисует CPU-растеризатор (native/graphics/cpu_backend.c), поэтому
         устройство без Vulkan игру не выкидывает из магазина. -->
    <uses-feature android:name="android.hardware.vulkan.version" android:required="false" android:version="0x00010000" />
    <uses-feature android:name="android.hardware.vulkan.level" android:required="false" />

    <application
        android:label="Cubic Battle 4"
        android:icon="@mipmap/ic_launcher"
        android:hasCode="true"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true">

        <!-- singleTask: возврат в игру из свёрнутого состояния не должен
             создавать второй экземпляр NativeActivity. Два native-цикла в одном
             процессе делят общие глобальные переменные и Vulkan, и это
             заканчивалось вылетом. -->
        <activity
            android:name="com.cb4.GameActivity"
            android:launchMode="singleTask"
            android:configChanges="orientation|keyboard|keyboardHidden|screenSize"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <meta-data
                android:name="android.app.lib_name"
                android:value="ds_game" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
