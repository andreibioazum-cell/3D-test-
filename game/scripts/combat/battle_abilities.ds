function universe_collapse(number dmg)
    if finished!=0
        return
    end
    if game_state!=ST_ONLINE
        number left=dmg
        if enemy_class==CLASS_EBUC
            left=enemy_shield_absorb(dmg)
        end
        if enemy_revive_prot<=0
            enemy.hp=enemy.hp-left
            if enemy.hp<0
                enemy.hp=0
            end
        end
    end
    number own=dmg
    if player_class==CLASS_EBUC
        own=player_shield_absorb(dmg)
    end
    player.hp=player.hp-own
    if player.hp<0
        player.hp=0
    end
    if player.hp<=0
        if try_revive()==0
            finish_game(2)
            return
        end
    end
    if finished==0&&game_state!=ST_ONLINE&&enemy.hp<=0
        if enemy_try_revive()==0
            finish_game(1)
        end
    end
end
function universe_collapse_remote(number dmg)
    if finished!=0
        return
    end
    number left=dmg
    if player_class==CLASS_EBUC
        left=player_shield_absorb(dmg)
    end
    player.hp=player.hp-left
    if player.hp<0
        player.hp=0
    end
    if player.hp<=0
        if try_revive()==0
            finish_game(2)
        end
    end
end
function tick_universe()
    if universe_active==0
        return
    end
    universe_t=universe_t+dt
    universe_a=clamp(universe_t/ebuc_universe_collapse_time,0,1)
    if universe_t>=ebuc_universe_collapse_time
        universe_active=0
        universe_hit=1
        universe_collapse(ebuc_universe_damage_for(player_level))
    end
end
function update_remote_station()
    if net_slot()<0
        return
    end
    number s=0
    loop s<max_players
        number b=s*station_fields
        if s==net_slot()||net_player_online(s)!=1
            number f=0
            loop f<station_fields
                arr_set(remote_station,b+f,0)
                f=f+1
            end
        else
            number i=0
            loop i<turret_max
                number o=b+1+i*5
                number hx=0, hy=0, hhp=0
                if i==0
                    hx=net_player_station_x(s)*screen_w
                    hy=net_player_station_y(s)*screen_h
                    hhp=net_player_station_hp(s)
                else if i==1
                    hx=net_player_station2_x(s)*screen_w
                    hy=net_player_station2_y(s)*screen_h
                    hhp=net_player_station2_hp(s)
                else
                    hx=net_player_station3_x(s)*screen_w
                    hy=net_player_station3_y(s)*screen_h
                    hhp=net_player_station3_hp(s)
                end
                number st=arr_get(remote_station,o)
                if hhp>0
                    arr_set(remote_station,o,1)
                    arr_set(remote_station,o+1,hx)
                    arr_set(remote_station,o+2,hy)
                    arr_set(remote_station,o+3,hhp)
                    arr_set(remote_station,o+4,0)
                    if st!=1
                        arr_set(remote_station,b,i+1)
                    end
                else
                    if st==1
                        arr_set(remote_station,o,2)
                        arr_set(remote_station,o+4,station_boom_time)
                    else if st==2
                        number bt=arr_get(remote_station,o+4)-dt
                        if bt<0
                            bt=0
                        end
                        arr_set(remote_station,o+4,bt)
                        if bt<=0
                            arr_set(remote_station,o,0)
                        end
                    end
                end
                i=i+1
            end
        end
        s=s+1
    end
end
function update_remote_universe()
    if net_slot()<0
        return
    end
    number s=0
    loop s<max_players
        number b=s*universe_fields
        if s==net_slot()||net_player_online(s)!=1
            arr_set(remote_universe,b,0)
            arr_set(remote_universe,b+1,0)
        else
            number ucnt=net_player_universe(s)
            number prev=arr_get(remote_universe,b)
            if ucnt!=prev&&ucnt>0
                arr_set(remote_universe,b,ucnt)
                arr_set(remote_universe,b+1,1)
                arr_set(remote_universe,b+2,net_player_universe_x(s)*screen_w)
                arr_set(remote_universe,b+3,net_player_universe_y(s)*screen_h)
                arr_set(remote_universe,b+4,0)
            end
            if arr_get(remote_universe,b+1)==1
                number t=arr_get(remote_universe,b+4)+dt
                arr_set(remote_universe,b+4,t)
                if t>=ebuc_universe_collapse_time
                    arr_set(remote_universe,b+1,0)
                    arr_set(remote_universe,b,0)
                    number rlevel=net_player_level(s)
                    universe_collapse_remote(ebuc_universe_damage_for(rlevel))
                    if finished!=0
                        return
                    end
                end
            end
        end
        s=s+1
    end
end
function update_remote_dashes()
    if net_slot()<0
        return
    end
    number s=0
    loop s<max_players
        number b=s*dash_fields
        if s==net_slot()||net_player_online(s)!=1
            arr_set(remote_dash,b,0)
            arr_set(remote_dash,b+1,0)
        else
            number gen=net_player_dash(s)
            if gen!=arr_get(remote_dash,b)
                arr_set(remote_dash,b,gen)
                if gen>0
                    arr_set(remote_dash,b+1,1)
                    arr_set(remote_dash,b+2,net_player_dash_x(s)*screen_w)
                    arr_set(remote_dash,b+3,net_player_dash_y(s)*screen_h)
                    arr_set(remote_dash,b+4,net_player_dash_dx(s))
                    arr_set(remote_dash,b+5,net_player_dash_dy(s))
                    arr_set(remote_dash,b+6,azum_dash_time)
                    arr_set(remote_dash,b+7,0)
                else
                    arr_set(remote_dash,b+1,0)
                end
            end
            if arr_get(remote_dash,b+1)==1
                number t=arr_get(remote_dash,b+6)-dt
                if t<0
                    t=0
                end
                arr_set(remote_dash,b+6,t)
                if t<=0
                    arr_set(remote_dash,b+1,0)
                    arr_set(remote_dash,b+7,0)
                else if arr_get(remote_dash,b+7)==0&&finished==0
                    number total_len=azum_dash_speed*azum_dash_time
                    number gone=total_len-azum_dash_speed*t
                    if gone<0
                        gone=0
                    end
                    if gone>total_len
                        gone=total_len
                    end
                    number target=dash_resolve_target(arr_get(remote_dash,b+2),arr_get(remote_dash,b+3),arr_get(remote_dash,b+4),arr_get(remote_dash,b+5),gone)
                    if target==0
                        arr_set(remote_dash,b+7,1)
                        if revive_prot<=0
                            take_damage(azum_dash_damage)
                            stun_player(azum_dash_stun)
                            ds_log("remote dash hit player")
                            if player.hp<=0
                                player.hp=0
                                if try_revive()==0
                                    finish_game(2)
                                    return
                                end
                            end
                        end
                    else if target>=1&&target<=turret_max
                        arr_set(remote_dash,b+7,1)
                        damage_turret(target-1,azum_dash_damage)
                    end
                end
            end
        end
        s=s+1
    end
end
function flush_queued_action()
    if queued_punch==0&&queued_super==0
        return
    end
    if punch_left>0||punch_cd>0||ultimate_visual_busy()==1
        return
    end
    if queued_super==1
        if player_class==CLASS_AZUM
            if dash_cd<=0
                queued_super=0
                fire_super()
                return
            end
        else
            if super_cd<=0
                queued_super=0
                fire_super()
                return
            end
        end
    end
    if queued_punch==1
        queued_punch=0
        fire_punch()
    end
end
function tick_dash()
    if dash_active>0
        dash_t=dash_t-dt
        if dash_t<=0
            dash_t=0
            dash_active=0
            dash_hit=0
        end
    end
    if dash_cd>0
        dash_cd=dash_cd-dt
        if dash_cd<0
            dash_cd=0
        end
    end
end
// Соло-леденцы: появление и сбор — с той же анимацией, что у Деда Мороза.
// Сбор не телепортирует леденец мгновенно: candy_pick заводит pop-out, а
// только когда он доигран, леденец возрождается в новой случайной точке.
function tick_candies()
    if candy_enabled==1
        number ci=0
        loop ci<candy_count
            number cp=arr_get(candy_pick,ci)
            if cp>0
                cp=cp-dt
                if cp<=0
                    cp=0
                    candy_rand_pos(ci)
                end
                arr_set(candy_pick,ci,cp)
            else
                arr_set(candy_t,ci,arr_get(candy_t,ci)+dt)
                if dist(arr_get(candy_x,ci),arr_get(candy_y,ci),player.x,player.y)<player.size*0.65+18
                    candies=candies+candy_give
                    save_progress()
                    quest_on_candy()
                    ds_log("candy picked -> %g",candies)
                    arr_set(candy_pick,ci,candy_pick_time)
                end
            end
            ci=ci+1
        end
    end
end
function update_game()
    card_update()
    tick_alert_hold()
    tick_revive()
    tick_freeze()
    tick_player_stun()
    tick_player_poison()
    tick_turrets()
    tick_universe()
    tick_enemy_class()
    tick_hitbox_fades()
    tick_status_fades()
    update_aim()
    if finished!=0
        return
    end
    if player.hp<=0
        if try_revive()==0
            finish_game(2)
            return
        end
    end
    move_player()
    tick_dash()
    tick_dash_solo_hit()
    tick_candies()
    if punch_left>0
        punch_left=punch_left-dt
        if punch_left<0
            punch_left=0
        end
    end
    follow_punch()
    if super_cd>0
        super_cd=super_cd-dt
        if super_cd<0
            super_cd=0
        end
    end
    if boom_t>0
        boom_t=boom_t-dt
        if boom_t<0
            boom_t=0
        end
    end
    tick_super_windup()
    tick_santa_follow()
    if punch_left>0&&punch.active==1&&punch.hit==0
        number enemy_turret_target=enemy_punch_turret_target(punch.x,punch.y,punch.dx,punch.dy)
        if enemy_turret_target>=1
            punch.hit=1
            enemy_damage_turret(enemy_turret_target-1,class_punch_damage(player_class))
            if revive_prot<=0
                take_damage(turret_counter_damage)
                if player.hp<=0
                    player.hp=0
                    if try_revive()==0
                        finish_game(2)
                        return
                    end
                end
            end
            heal_after_attack()
        else if enemy_in_punch()==1
            punch.hit=1
            if enemy_revive_prot<=0
                if player_class==2&&santa_follow>0
                    if player_level>=3
                        if enemy.poison<=0
                            enemy.poison_tick=santa_poison_tick_interval
                            enemy.poison_damage=santa_poison_damage_for(player_level)
                        else
                            enemy.poison_damage=enemy.poison_damage+santa_poison_damage_for(player_level)
                        end
                        enemy.poison=santa_poison_time_for(player_level)
                    else
                        if enemy.poison<=0
                            enemy.poison_tick=santa_poison_tick_interval
                        end
                        enemy.poison=santa_poison_time_for(player_level)
                    end
                end
                heal_after_attack()
                if enemy_apply_damage(class_punch_damage(player_class))==1
                    return
                end
            end
        end
    end
    update_dust()
    update_gift()
    flush_queued_action()
    if finished!=0
        return
    end
    update_enemy()
end
