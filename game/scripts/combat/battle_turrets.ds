public number last_turret_slot=0
public function turret_alive(number i)
    if arr_get(turret_hp,i)>0 then
        return 1
    end
    return 0
end
public function turret_count_alive()
    local number n=0, i=0
    while i<turret_max do
        if turret_alive(i)==1 then
            n=n+1
        end
        i=i+1
    end
    return n
end
public function push_station_boom(number x, number y)
    arr_push(station_boom_xs,x)
    arr_push(station_boom_ys,y)
    arr_push(station_boom_ts,station_boom_time)
    if arr_len(station_boom_ts)>station_booms_max then
        local number keep=station_booms_max
        local array nx=arr_new()
        local array ny=arr_new()
        local array nt=arr_new()
        local number i=arr_len(station_boom_ts)-keep
        while i<arr_len(station_boom_ts) do
            arr_push(nx,arr_get(station_boom_xs,i))
            arr_push(ny,arr_get(station_boom_ys,i))
            arr_push(nt,arr_get(station_boom_ts,i))
            i=i+1
        end
        station_boom_xs=nx
        station_boom_ys=ny
        station_boom_ts=nt
    end
end
public function destroy_turret(number i)
    if i<0||i>=turret_max then
        return
    end
    if turret_alive(i)==0 then
        return
    end
    push_station_boom(arr_get(turret_x,i),arr_get(turret_y,i))
    arr_set(turret_hp,i,0)
    arr_set(turret_maxhp,i,0)
    arr_set(turret_spawn_t,i,0)
end
public function damage_turret(number i, number dmg)
    if i<0||i>=turret_max then
        return
    end
    if turret_alive(i)==0 then
        return
    end
    local number h=arr_get(turret_hp,i)-dmg
    if h<=0 then
        push_station_boom(arr_get(turret_x,i),arr_get(turret_y,i))
        arr_set(turret_hp,i,0)
        arr_set(turret_maxhp,i,0)
        arr_set(turret_spawn_t,i,0)
        return
    end
    arr_set(turret_hp,i,h)
end
public function place_turret()
    local number slot=-1, i=0
    while i<turret_max do
        if turret_alive(i)==0 then
            slot=i
            i=turret_max
        end
        i=i+1
    end
    if slot<0 then
        i=0
        while i<turret_max do
            if turret_alive(i)==1 then
                slot=i
                i=turret_max
            end
            i=i+1
        end
        if slot<0 then
            return
        end
        destroy_turret(slot)
    end
    arr_set(turret_x,slot,player.x)
    arr_set(turret_y,slot,player.y)
    local number mh=ebuc_station_hp_for(player_level)
    arr_set(turret_maxhp,slot,mh)
    arr_set(turret_hp,slot,mh)
    arr_set(turret_spawn_t,slot,station_spawn_time)
    last_turret_slot=slot
    if player_level>=2 then
        player.hp=clamp(player.hp+ebuc_place_heal,0,player.max_hp)
    end
end
public function tick_station_boom()
    local number i=0
    while i<arr_len(station_boom_ts) do
        local number t=arr_get(station_boom_ts,i)
        if t>0 then
            t=t-dt
            if t<0 then
                t=0
            end
            arr_set(station_boom_ts,i,t)
        end
        i=i+1
    end
end
public function tick_turrets()
    tick_station_boom()
    local number i=0
    while i<turret_max do
        if arr_get(turret_spawn_t,i)>0 then
            local number t=arr_get(turret_spawn_t,i)-dt
            if t<0 then
                t=0
            end
            arr_set(turret_spawn_t,i,t)
        end
        i=i+1
    end
    if player_class==CLASS_EBUC&&player_level>=3&&turret_count_alive()>0&&finished==0&&player.hp>0 then
        turret_heal_t=turret_heal_t+dt
        if turret_heal_t>=1 then
            turret_heal_t=turret_heal_t-1
            player.hp=clamp(player.hp+ebuc_beam_heal,0,player.max_hp)
        end
    else
        turret_heal_t=0
    end
end
