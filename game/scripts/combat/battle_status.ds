public function tick_freeze()
    if player_freeze>0 then
        player_freeze=player_freeze-dt
        if player_freeze<0 then
            player_freeze=0
        end
    end
end
public function tick_player_stun()
    if player_stun>0 then
        player_stun=player_stun-dt
        if player_stun<0 then
            player_stun=0
        end
    end
end
public function tick_player_poison()
    if player_poison>0 then
        if player_poison_tick<=0 then
            player_poison_tick=santa_poison_tick_interval
        end
        player_poison=player_poison-dt
        player_poison_tick=player_poison_tick-dt
        if player_poison_tick<=0 then
            take_damage(player_poison_damage)
            player_poison=0
            player_poison_tick=0
            player_poison_damage=0
        end
        if player_poison<=0 then
            player_poison=0
            player_poison_tick=0
            player_poison_damage=0
        end
    end
end
public function fade_up_status(number a)
    a=a+dt/freeze_fade_in
    if a>1 then
        a=1
    end
    return a
end
public function fade_down_status(number a)
    a=a-dt/freeze_fade_out
    if a<0 then
        a=0
    end
    return a
end
public function status_alpha(number a, number live)
    if finished!=0 then
        return fade_down_status(a)
    end
    if live==1 then
        return fade_up_status(a)
    end
    return fade_down_status(a)
end
public function tick_status_fades()
    local number efreeze=0, epoison=0, estun=0
    if game_state==ST_SOLO then
        if enemy.freeze>0 then
            efreeze=1
        end
        if enemy.poison>0 then
            epoison=1
        end
        if enemy.stun>0 then
            estun=1
        end
    end
    freeze_a=status_alpha(freeze_a,efreeze)
    poison_a=status_alpha(poison_a,epoison)
    stun_a=status_alpha(stun_a,estun)
    local number pfreeze=0, ppoison=0, pstun=0
    if player_freeze>0 then
        pfreeze=1
    end
    if player_poison>0 then
        ppoison=1
    end
    if player_stun>0 then
        pstun=1
    end
    pfreeze_a=status_alpha(pfreeze_a,pfreeze)
    ppoison_a=status_alpha(ppoison_a,ppoison)
    pstun_a=status_alpha(pstun_a,pstun)
end
