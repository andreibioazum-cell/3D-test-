public number enemy_last_turret_slot=0
public function enemy_turret_alive(number i)
    if i<0||i>=turret_max then
        return 0
    end
    if arr_get(enemy_turret_hp,i)>0 then
        return 1
    end
    return 0
end
public function enemy_turret_count_alive()
    local number n=0, i=0
    while i<turret_max do
        if enemy_turret_alive(i)==1 then
            n=n+1
        end
        i=i+1
    end
    return n
end
public function enemy_destroy_turret(number i)
    if enemy_turret_alive(i)==0 then
        return
    end
    push_station_boom(arr_get(enemy_turret_x,i),arr_get(enemy_turret_y,i))
    arr_set(enemy_turret_hp,i,0)
    arr_set(enemy_turret_maxhp,i,0)
    arr_set(enemy_turret_spawn_t,i,0)
end
public function enemy_damage_turret(number i, number dmg)
    if enemy_turret_alive(i)==0 then
        return
    end
    local number h=arr_get(enemy_turret_hp,i)-dmg
    if h<=0 then
        push_station_boom(arr_get(enemy_turret_x,i),arr_get(enemy_turret_y,i))
        arr_set(enemy_turret_hp,i,0)
        arr_set(enemy_turret_maxhp,i,0)
        arr_set(enemy_turret_spawn_t,i,0)
        return
    end
    arr_set(enemy_turret_hp,i,h)
end
public function enemy_place_turret()
    local number slot=-1, i=0
    while i<turret_max do
        if enemy_turret_alive(i)==0 then
            slot=i
            i=turret_max
        end
        i=i+1
    end
    if slot<0 then
        i=0
        while i<turret_max do
            if enemy_turret_alive(i)==1 then
                slot=i
                i=turret_max
            end
            i=i+1
        end
        if slot<0 then
            return
        end
        enemy_destroy_turret(slot)
    end
    arr_set(enemy_turret_x,slot,enemy.x)
    arr_set(enemy_turret_y,slot,enemy.y)
    local number mh=ebuc_station_hp
    arr_set(enemy_turret_maxhp,slot,mh)
    arr_set(enemy_turret_hp,slot,mh)
    arr_set(enemy_turret_spawn_t,slot,station_spawn_time)
    enemy_last_turret_slot=slot
    ds_log("enemy turret placed, alive %g/%g",enemy_turret_count_alive(),turret_max)
end
public function enemy_punch_turret_target(number px, number py, number pdx, number pdy)
    local number best=-1, bfw=0, i=0
    local number bw=(enemy.x-px)*pdx+(enemy.y-py)*pdy
    local number th=punch_width/2+turret_zone_half()
    local number back=turret_zone_half()
    local number front=punch_front_offset(player.size)
    while i<turret_max do
        if enemy_turret_alive(i)==1 then
            local number hx=arr_get(enemy_turret_x,i)-px, hy=arr_get(enemy_turret_y,i)-py
            local number tf=hx*pdx+hy*pdy, ts=hy*pdx-hx*pdy
            if tf>=0-back&&tf<=punch_reach+back+front&&fabs(ts)<=th then
                if tf<=bw+30 then
                    if best==-1||tf<bfw then
                        best=i+1
                        bfw=tf
                    end
                end
            end
        end
        i=i+1
    end
    return best
end
public function enemy_tick_turrets()
    local number i=0
    while i<turret_max do
        if arr_get(enemy_turret_spawn_t,i)>0 then
            local number t=arr_get(enemy_turret_spawn_t,i)-dt
            if t<0 then
                t=0
            end
            arr_set(enemy_turret_spawn_t,i,t)
        end
        i=i+1
    end
end
public function draw_enemy_turrets()
    local number beam=-1
    if station_beam_visible(enemy.hp)==1 then
        if enemy_turret_alive(enemy_last_turret_slot)==1 then
            beam=enemy_last_turret_slot
        else
            local number j=0
            while j<turret_max do
                if enemy_turret_alive(j)==1 then
                    beam=j
                    j=turret_max
                end
                j=j+1
            end
        end
    end
    if beam>=0 then
        draw_station_beam(arr_get(enemy_turret_x,beam),arr_get(enemy_turret_y,beam),enemy.x,enemy.y)
    end
    local number i=0
    while i<turret_max do
        if enemy_turret_alive(i)==1 then
            draw_turret_at(arr_get(enemy_turret_x,i),arr_get(enemy_turret_y,i),arr_get(enemy_turret_hp,i),arr_get(enemy_turret_maxhp,i),arr_get(enemy_turret_spawn_t,i))
        end
        i=i+1
    end
end
