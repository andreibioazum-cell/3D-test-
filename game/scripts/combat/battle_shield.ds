public function pierce_has(number mask, number bit)
    local number shifted=floor(mask/bit)
    return shifted-floor(shifted*0.5)*2
end
public function nearest_own_turret()
    local number best=-1, bd=0, i=0
    while i<turret_max do
        if turret_alive(i)==1 then
            local number d=dist(arr_get(turret_x,i),arr_get(turret_y,i),player.x,player.y)
            if best==-1||d<bd then
                best=i
                bd=d
            end
        end
        i=i+1
    end
    return best
end
public function nearest_enemy_turret()
    local number best=-1, bd=0, i=0
    while i<turret_max do
        if enemy_turret_alive(i)==1 then
            local number d=dist(arr_get(enemy_turret_x,i),arr_get(enemy_turret_y,i),enemy.x,enemy.y)
            if best==-1||d<bd then
                best=i
                bd=d
            end
        end
        i=i+1
    end
    return best
end
public function player_shield_absorb(number dmg)
    if player_class!=CLASS_EBUC then
        return dmg
    end
    if dmg<=0 then
        return 0
    end
    local number left=dmg
    while left>0 do
        local number best=nearest_own_turret()
        if best<0 then
            return left
        end
        local number hp=arr_get(turret_hp,best)
        local number take=hp
        if left<take then
            take=left
        end
        damage_turret(best,take)
        left=left-take
    end
    return 0
end
public function enemy_shield_absorb(number dmg)
    if enemy_class!=CLASS_EBUC then
        return dmg
    end
    if dmg<=0 then
        return 0
    end
    local number left=dmg
    while left>0 do
        local number best=nearest_enemy_turret()
        if best<0 then
            return left
        end
        local number hp=arr_get(enemy_turret_hp,best)
        local number take=hp
        if left<take then
            take=left
        end
        enemy_damage_turret(best,take)
        left=left-take
    end
    return 0
end
public function snow_chip_enemy_turrets()
    if gift.active==0 then
        return
    end
    local number zone=turret_zone_half()+20, i=0
    while i<turret_max do
        if enemy_turret_alive(i)==1 then
            local number bit=1
            if i==1 then
                bit=2
            else if i==2 then
                bit=4
            end
            if pierce_has(gift.pierce,bit)==0 then
                if fabs(gift.x-arr_get(enemy_turret_x,i))<zone&&fabs(gift.y-arr_get(enemy_turret_y,i))<zone then
                    gift.pierce=gift.pierce+bit
                    enemy_damage_turret(i,santa_super_damage)
                    ds_log("snow pierced enemy turret %g",i)
                end
            end
        end
        i=i+1
    end
end
public function snow_chip_player_turrets()
    if enemy_gift.active==0 then
        return
    end
    local number zone=turret_zone_half()+20, i=0
    while i<turret_max do
        if turret_alive(i)==1 then
            local number bit=1
            if i==1 then
                bit=2
            else if i==2 then
                bit=4
            end
            if pierce_has(enemy_gift.pierce,bit)==0 then
                if fabs(enemy_gift.x-arr_get(turret_x,i))<zone&&fabs(enemy_gift.y-arr_get(turret_y,i))<zone then
                    enemy_gift.pierce=enemy_gift.pierce+bit
                    damage_turret(i,santa_super_damage)
                    ds_log("enemy snow pierced turret %g",i)
                end
            end
        end
        i=i+1
    end
end
