public function fade_up_a(number a, number t)
    if t<=0 then
        return 1
    end
    a=a+dt/t
    if a>1 then
        a=1
    end
    return a
end
public function fade_down_a(number a, number t)
    if t<=0 then
        return 0
    end
    a=a-dt/t
    if a<0 then
        a=0
    end
    return a
end
public function hb_env(number a)
    if a<0 then
        a=0
    end
    if a>1 then
        a=1
    end
    return a
end
-- Цвет всех боевых зон ОДИН: hitbox_rgb плюс hitbox_zone_alpha, умноженная на
-- «конверт» конкретной зоны (её плавное появление и затухание). Раньше у
-- каждой зоны была своя альфа (36 / 102 / 140 / 170) и свой контур поверх
-- заливки, поэтому хитбоксы выглядели по-разному; теперь прозрачность у всех
-- одинаковая.
public function hb_zone_col(number env)
    local number a=floor(hitbox_zone_alpha*hb_env(env))
    if a<0 then
        a=0
    end
    if a>255 then
        a=255
    end
    return (((unsigned)(int)a)<<24)|((unsigned)(int)hitbox_rgb)
end
-- Ровная полоса от точки (sx,sy) вдоль направления (dx,dy): от отступа off0 до
-- off1, шириной 2*half_w. Ей рисуются все «линейные» зоны хитбоксов (удар,
-- путь снежка, рамка вселенной) вместо line(): у линии круглые заглушки на
-- концах, а скруглений в хитбоксах быть не должно вообще. rect_rot рисует
-- обычным конвейером со смешиванием, поэтому полоса прозрачная.
public function draw_hit_strip(number sx, number sy, number dx, number dy, number off0, number off1, number half_w, number env)
    if show_hitboxes==0||env<=0||half_w<=0 then
        return
    end
    local number len=off1-off0
    if len<=0 then
        return
    end
    local number mid=(off0+off1)/2
    rect_rot(sx+dx*mid-len/2,sy+dy*mid-half_w,len,half_w*2,atan2(dy,dx),hb_zone_col(env))
end
public function draw_hit_circle(number x, number y, number r, number env)
    if show_hitboxes==0 then
        return
    end
    if r<=0||env<=0 then
        return
    end
    circle(x,y,r,hb_zone_col(env))
end
public function draw_hit_line(number x1, number y1, number x2, number y2, number w, number env)
    local number dx=x2-x1, dy=y2-y1
    local number len=sqrt(dx*dx+dy*dy)
    if w<=0||env<=0||len<=0 then
        return
    end
    draw_hit_strip(x1,y1,dx/len,dy/len,0,len,w/2,env)
end
public function draw_hit_snowball(number x, number y, number dx, number dy, number t, number r, number env)
    draw_hit_circle(x,y,r,env)
    local number left=super_range-t*super_speed
    if left>0 then
        draw_hit_strip(x,y,dx,dy,0,left,r,env)
    end
end
public function snow_hit_radius(number target_size)
    return target_size*0.65+24
end
public function draw_hit_snow()
    if snow_ball_a>0 then
        local number r=snow_hit_radius(enemy.size)
        if game_state==ST_ONLINE then
            r=snow_hit_radius(player.size)
        end
        draw_hit_snowball(gift.x,gift.y,gift.dx,gift.dy,gift.t,r,snow_ball_a)
    end
    if snow_boom_a>0 then
        draw_hit_circle(boom_x,boom_y,super_radius,snow_boom_a)
    end
    if game_state==ST_SOLO then
        if esnow_ball_a>0 then
            local number er=snow_hit_radius(player.size)
            draw_hit_snowball(enemy_gift.x,enemy_gift.y,enemy_gift.dx,enemy_gift.dy,enemy_gift.t,er,esnow_ball_a)
        end
        if esnow_boom_a>0 then
            draw_hit_circle(enemy_boom_x,enemy_boom_y,super_radius,esnow_boom_a)
        end
    end
    if game_state!=ST_ONLINE then
        return
    end
    if net_slot()<0 then
        return
    end
    local number s=0
    while s<max_players do
        local number b=s*snow_fields
        if arr_get(rsnow_ball_a,s)>0 then
            local number rr=snow_hit_radius(player.size)
            draw_hit_snowball(arr_get(remote_snow,b+3),arr_get(remote_snow,b+4),net_player_snow_dx(s),net_player_snow_dy(s),arr_get(remote_snow,b+2),rr,arr_get(rsnow_ball_a,s))
        end
        if arr_get(rsnow_boom_a,s)>0 then
            draw_hit_circle(arr_get(remote_snow,b+6),arr_get(remote_snow,b+7),super_radius,arr_get(rsnow_boom_a,s))
        end
        s=s+1
    end
end
-- Клетки зоны рывка: один общий массив на все вызовы (раньше на каждый кадр
-- рывка создавался и выбрасывался свой), а повтор предыдущей клетки отсекается
-- сравнением с соседом — путь прямой, поэтому в одну клетку можно попасть
-- только дважды подряд. Клетки рисуются острыми квадратами (rect) того же
-- цвета и той же прозрачности, что и все остальные хитбоксы: roundrect здесь
-- больше не используется — у него и углы скруглённые, и конвейер без
-- смешивания (зона выглядела залитыми чёрными плитами, а не полупрозрачной).
public array dash_cells=arr_new()
public function draw_hit_dash_path(number sx, number sy, number dx, number dy, number cx, number cy, number pr, number env)
    if pr<=0||env<=0 then
        return
    end
    local number travel=(cx-sx)*dx+(cy-sy)*dy
    if travel<0 then
        travel=0
    end
    local number len=azum_dash_speed*azum_dash_time
    if travel>len then
        travel=len
    end
    local number side=pr*dash_hitbox_zone_scale
    if side<=0 then
        side=2
    end
    arr_clear(dash_cells)
    local number off=0, step=side*0.5, px=0, py=0, gx=0, gy=0, prev_x=0, prev_y=0, first=1
    while off<=travel do
        px=sx+dx*off
        py=sy+dy*off
        gx=floor(px/side)
        gy=floor(py/side)
        if first==1||gx!=prev_x||gy!=prev_y then
            arr_push(dash_cells,gx)
            arr_push(dash_cells,gy)
            prev_x=gx
            prev_y=gy
            first=0
        end
        off=off+step
    end
    local number col=hb_zone_col(env)
    local number k=0
    while k<arr_len(dash_cells) do
        gx=arr_get(dash_cells,k)
        gy=arr_get(dash_cells,k+1)
        rect(gx*side,gy*side,side,side,col)
        k=k+2
    end
end
public function draw_hit_dash()
    if dash_box_a>0 then
        local number dpr=dash_hit_radius_remote()
        if game_state==ST_SOLO then
            dpr=dash_hit_radius_solo()
        end
        draw_hit_dash_path(dash_x0,dash_y0,dash_dx,dash_dy,player.x,player.y,dpr,dash_box_a)
    end
    if game_state==ST_SOLO&&edash_box_a>0 then
        local number epr=dash_hit_radius_solo()
        draw_hit_dash_path(enemy_dash_x0,enemy_dash_y0,enemy_dash_dx,enemy_dash_dy,enemy.x,enemy.y,epr,edash_box_a)
    end
    if game_state!=ST_ONLINE then
        return
    end
    if net_slot()<0 then
        return
    end
    local number s=0
    while s<max_players do
        local number b=s*dash_fields
        if s!=net_slot()&&arr_get(rdash_box_a,s)>0 then
            local number rx=arr_get(remote_dash,b+2), ry=arr_get(remote_dash,b+3)
            local number rdx=arr_get(remote_dash,b+4), rdy=arr_get(remote_dash,b+5)
            local number gone=azum_dash_speed*(azum_dash_time-arr_get(remote_dash,b+6))
            local number pr=dash_hit_radius_remote()
            draw_hit_dash_path(rx,ry,rdx,rdy,rx+rdx*gone,ry+rdy*gone,pr,arr_get(rdash_box_a,s))
        end
        s=s+1
    end
end
public function draw_hit_universe_frame(number env)
    local number w=7
    draw_hit_line(0,0,screen_w,0,w,env)
    draw_hit_line(0,screen_h,screen_w,screen_h,w,env)
    draw_hit_line(0,0,0,screen_h,w,env)
    draw_hit_line(screen_w,0,screen_w,screen_h,w,env)
end
public function draw_hit_universe()
    if universe_box_a>0 then
        draw_hit_universe_frame(universe_box_a)
        draw_hit_circle(universe_x,universe_y,60,universe_box_a)
    end
    if game_state!=ST_ONLINE then
        return
    end
    if net_slot()<0 then
        return
    end
    local number s=0
    while s<max_players do
        local number b=s*universe_fields
        if s!=net_slot()&&arr_get(runiverse_box_a,s)>0 then
            draw_hit_universe_frame(arr_get(runiverse_box_a,s))
            draw_hit_circle(arr_get(remote_universe,b+2),arr_get(remote_universe,b+3),60,arr_get(runiverse_box_a,s))
        end
        s=s+1
    end
end
public function draw_ability_hitboxes()
    if show_hitboxes==0 then
        return
    end
    draw_hit_snow()
    draw_hit_dash()
    draw_hit_universe()
end
