public function move_player()
    if player_stun>0||plates_lock_me==1 then
        return
    end
    if dash_active>0 then
        local number jm2=sqrt(joy.dx*joy.dx+joy.dy*joy.dy)
        if jm2>0.15 then
            player.angle=atan2(joy.dy,joy.dx)
        end
        player.x=player.x+dash_dx*azum_dash_speed*dt
        player.y=player.y+dash_dy*azum_dash_speed*dt
        if player.x<player.size then
            player.x=player.size
            dash_active=0
            dash_t=0
        end
        if player.x>screen_w-player.size then
            player.x=screen_w-player.size
            dash_active=0
            dash_t=0
        end
        if player.y<player.size then
            player.y=player.size
            dash_active=0
            dash_t=0
        end
        if player.y>screen_h-player.size then
            player.y=screen_h-player.size
            dash_active=0
            dash_t=0
        end
        if dash_active==1 then
            tick_dust(dash_dx,dash_dy,1)
        end
        return
    end
    local number spd=joy_speed
    if player_class==CLASS_AZUM&&player_level>=2 then
        spd=spd*(1+azum_speed_bonus)
    else if player_class==CLASS_ORDINARY&&player_level>=2 then
        spd=spd*(1+ordinary_speed_bonus)
    end
    if player_freeze>0 then
        spd=spd*player_freeze_slow
    end
    player.x=player.x+joy.dx*spd*dt
    player.y=player.y+joy.dy*spd*dt
    local number jm=sqrt(joy.dx*joy.dx+joy.dy*joy.dy)
    if jm>0.15 then
        player.angle=atan2(joy.dy,joy.dx)
    end
    if player.x<player.size then
        player.x=player.size
    end
    if player.x>screen_w-player.size then
        player.x=screen_w-player.size
    end
    if player.y<player.size then
        player.y=player.size
    end
    if player.y>screen_h-player.size then
        player.y=screen_h-player.size
    end
    tick_dust(joy.dx,joy.dy,jm)
end
public function in_punch_box(number px, number py, number pdx, number pdy, number tx, number ty)
    local number rx=tx-px, ry=ty-py, fw=rx*pdx+ry*pdy, side=ry*pdx-rx*pdy
    if fw>=0&&fw<=punch_reach+punch_front_offset(player.size)&&side*side<=punch_width*punch_width/4 then
        return 1
    end
    return 0
end
public function enemy_in_punch()
    local number ex=enemy.x, ey=enemy.y, hs=enemy.size*0.65
    local number fx=cos(enemy.angle)*hs, fy=sin(enemy.angle)*hs, sx=-sin(enemy.angle)*hs, sy=cos(enemy.angle)*hs
    if in_punch_box(punch.x,punch.y,punch.dx,punch.dy,ex,ey)==1 then
        return 1
    end
    if in_punch_box(punch.x,punch.y,punch.dx,punch.dy,ex-fx-sx,ey-fy-sy)==1 then
        return 1
    end
    if in_punch_box(punch.x,punch.y,punch.dx,punch.dy,ex+fx-sx,ey+fy-sy)==1 then
        return 1
    end
    if in_punch_box(punch.x,punch.y,punch.dx,punch.dy,ex+fx+sx,ey+fy+sy)==1 then
        return 1
    end
    if in_punch_box(punch.x,punch.y,punch.dx,punch.dy,ex-fx+sx,ey-fy+sy)==1 then
        return 1
    end
    return 0
end
public function update_aim()
    if punch_left>0&&super_windup<=0&&finished==0 then
        aim_a=aim_a+dt/aim_fade_in
        if aim_a>1 then
            aim_a=1
        end
    else
        aim_a=aim_a-dt/aim_fade_out
        if aim_a<0 then
            aim_a=0
        end
    end
    if punch_cd>0 then
        punch_cd=punch_cd-dt
        if punch_cd<0 then
            punch_cd=0
        end
    end
end
public function follow_punch()
    if punch_left<=0 then
        return
    end
    punch.x=player.x
    punch.y=player.y
    punch.dx=cos(player.angle)
    punch.dy=sin(player.angle)
end
public function enemy_freeze_factor()
    if enemy.freeze>0 then
        return enemy.freeze_slow
    end
    return 1
end
public function freeze_enemy(number t, number slow)
    if t>enemy.freeze then
        enemy.freeze=t
        enemy.freeze_slow=slow
    end
end
public function enemy_move(number vx, number vy)
    local number f=enemy_freeze_factor()*enemy.speed_var
    enemy.mvx=vx*f
    enemy.mvy=vy*f
    enemy.svx=vx
    enemy.svy=vy
    enemy.x=enemy.x+vx*f*dt
    enemy.y=enemy.y+vy*f*dt
    if enemy.x<enemy.size then
        enemy.x=enemy.size
    end
    if enemy.x>screen_w-enemy.size then
        enemy.x=screen_w-enemy.size
    end
    if enemy.y<enemy.size then
        enemy.y=enemy.size
    end
    if enemy.y>screen_h-enemy.size then
        enemy.y=screen_h-enemy.size
    end
    tick_enemy_dust(enemy.mvx,enemy.mvy)
end
public function enemy_face_motion()
    local number sp=sqrt(enemy.mvx*enemy.mvx+enemy.mvy*enemy.mvy)
    if sp<10 then
        return
    end
    local number ta=atan2(enemy.mvy,enemy.mvx), da=ta-enemy.angle
    if da>pi then
        da=da-2*pi
    end
    if da<0-pi then
        da=da+2*pi
    end
    local number wob = sin(enemy.wobble_t*2.3)*0.15
    da = da + wob
    local number turn=da*clamp(dt*enemy_face_speed,0,1), maxturn=enemy_face_max_speed*dt
    enemy.angle=enemy.angle+clamp(turn,0-maxturn,maxturn)
end
public function enemy_track_player()
    if enemy.seen==0 then
        enemy.px=player.x
        enemy.py=player.y
        enemy.pvx=0
        enemy.pvy=0
        enemy.seen=1
        return
    end
    local number vx=0, vy=0
    if dt>0 then
        vx=(player.x-enemy.px)/dt
        vy=(player.y-enemy.py)/dt
    end
    local number sp=sqrt(vx*vx+vy*vy)
    if sp>joy_speed then
        vx=vx/sp*joy_speed
        vy=vy/sp*joy_speed
    end
    vx = vx + (rand()%100-50)/100.0*12
    vy = vy + (rand()%100-50)/100.0*12
    enemy.pvx=lerp(enemy.pvx,vx,0.25)
    enemy.pvy=lerp(enemy.pvy,vy,0.25)
    enemy.px=player.x
    enemy.py=player.y
end
public function enemy_predict(number lead)
    local number errx = (rand()%100-50)/100.0*18
    local number erry = (rand()%100-50)/100.0*18
    aim_tx=clamp(player.x+enemy.pvx*lead+errx,player.size,screen_w-player.size)
    aim_ty=clamp(player.y+enemy.pvy*lead+erry,player.size,screen_h-player.size)
end
public function enemy_turn_prediction()
    enemy_predict(enemy_lead)
    local number ta=atan2(aim_ty-enemy.y,aim_tx-enemy.x)+enemy.aim_err, da=ta-enemy.angle
    if da>pi then
        da=da-2*pi
    end
    if da<0-pi then
        da=da+2*pi
    end
    local number step=enemy_attack_turn_speed*dt
    enemy.angle=enemy.angle+clamp(da,0-step,step)
end
public function player_in_enemy_punch()
    local number pdx=cos(enemy.angle), pdy=sin(enemy.angle), rx=player.x-enemy.x, ry=player.y-enemy.y
    local number fw=rx*pdx+ry*pdy, side=ry*pdx-rx*pdy, pr=player.size*0.65, half=enemy_punch_width/2+pr
    if fw>=0&&fw<=enemy_punch_reach+pr+punch_front_offset(enemy.size)&&side*side<=half*half then
        return 1
    end
    return 0
end
public function enemy_would_hit()
    enemy_predict(enemy_lead)
    local number rx=aim_tx-enemy.x, ry=aim_ty-enemy.y, fd=sqrt(rx*rx+ry*ry)
    local number pr=player.size*0.65
    local number margin=enemy_hit_margin
    if sqrt(enemy.pvx*enemy.pvx+enemy.pvy*enemy.pvy)<enemy_still_speed then
        margin=0
    end
    if fd<=enemy_punch_reach+pr-margin then
        return 1
    end
    return 0
end
public function enemy_in_danger()
    local number pdx=cos(player.angle), pdy=sin(player.angle), rx=enemy.x-player.x, ry=enemy.y-player.y
    local number fw=rx*pdx+ry*pdy, side=ry*pdx-rx*pdy, er=enemy.size*0.65, half=punch_width/2+er
    if fw>=-er&&fw<=punch_reach+er+punch_front_offset(player.size)&&side*side<=half*half then
        return 1
    end
    return 0
end
public function enemy_free_window()
    if punch_left<=0&&punch_cd>enemy_punish_react then
        return 1
    end
    return 0
end
public function enemy_pick_flank()
    local number side=(enemy.y-player.y)*cos(player.angle)-(enemy.x-player.x)*sin(player.angle)
    if side>=0 then
        enemy.strafe=1
    else
        enemy.strafe=-1
    end
    if rand()%100 < 22 then
        enemy.strafe = 0 - enemy.strafe
    end
end
public function enemy_roll_cooldown()
    local number r=enemy_cooldown_min+(rand()%1000)/1000.0*(enemy_cooldown_max-enemy_cooldown_min)
    enemy.speed_var=0.85 + (rand()%100)/100.0*enemy_human_speed_var
    if r<enemy_cooldown_min then
        r=enemy_cooldown_min
    end
    return r
end
