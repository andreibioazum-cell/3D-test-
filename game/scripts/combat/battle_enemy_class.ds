public function enemy_reset_class_state()
    enemy_class=CLASS_ORDINARY
    enemy_level=0
    enemy_super_cd=0
    enemy_super_windup=0
    enemy_super_kind=0
    enemy_revived=0
    enemy_revive_prot=0
    enemy_gift.active=0
    enemy_gift.t=0
    enemy_gift.shot=0
    enemy_boom_t=0
    enemy_boom_x=0
    enemy_boom_y=0
    enemy_dash_active=0
    enemy_dash_t=0
    enemy_dash_dx=0
    enemy_dash_dy=0
    enemy_dash_hit=0
    enemy_dash_cd=0
    enemy_dash_x0=0
    enemy_dash_y0=0
    enemy_last_turret_slot=0
    arr_clear(enemy_turret_x)
    arr_clear(enemy_turret_y)
    arr_clear(enemy_turret_hp)
    arr_clear(enemy_turret_maxhp)
    arr_clear(enemy_turret_spawn_t)
    arr_clear(enemy_turret_box_a)
    local number i=0
    while i<turret_max do
        arr_push(enemy_turret_x,0)
        arr_push(enemy_turret_y,0)
        arr_push(enemy_turret_hp,0)
        arr_push(enemy_turret_maxhp,0)
        arr_push(enemy_turret_spawn_t,0)
        arr_push(enemy_turret_box_a,0)
        i=i+1
    end
end
public function enemy_pick_random_class()
    local number roll=rand()%100
    local number azum_to=enemy_class_azum_chance
    local number ebuc_to=azum_to+enemy_class_ebuc_chance
    local number santa_to=ebuc_to+enemy_class_santa_chance
    if roll<azum_to then
        enemy_class=CLASS_AZUM
    else if roll<ebuc_to then
        enemy_class=CLASS_EBUC
    else if roll<santa_to then
        enemy_class=CLASS_SANTA
    else
        enemy_class=CLASS_ORDINARY
    end
    enemy_level=0
    enemy_revived=0
    enemy_revive_prot=0
    enemy_super_cd=enemy_first_super_min+(rand()%100)/100.0*(enemy_first_super_max-enemy_first_super_min)
    enemy_super_windup=0
    enemy_super_kind=0
    enemy_dash_cd=enemy_first_super_min+(rand()%100)/100.0*2.0
    enemy_dash_active=0
    enemy.max_hp=player_max_hp_for(enemy_class)
    enemy.hp=enemy.max_hp
    ds_log("enemy class %g hp %g",enemy_class,enemy.max_hp)
end
public function enemy_apply_damage(number dmg)
    if finished!=0 then
        return 1
    end
    if enemy_revive_prot>0 then
        return 0
    end
    if enemy_class==CLASS_EBUC then
        dmg=enemy_shield_absorb(dmg)
    end
    enemy.hp=enemy.hp-dmg
    if enemy.hp<0 then
        enemy.hp=0
    end
    if enemy.hp<=0 then
        if enemy_try_revive()==1 then
            return 0
        end
        finish_game(1)
        return 1
    end
    return 0
end
public function enemy_try_revive()
    if enemy.hp>0 then
        return 0
    end
    if enemy_class!=CLASS_AZUM then
        return 0
    end
    if enemy_revived==1 then
        return 0
    end
    enemy_revived=1
    enemy.hp=enemy.max_hp
    enemy_revive_prot=enemy_revive_prot_time
    local number k=0
    while k<50 do
        local number rx=70+rand()%(screen_w-140), ry=70+rand()%(screen_h-140)
        if dist(rx,ry,player.x,player.y)>200 then
            k=50
            enemy.x=rx
            enemy.y=ry
        else
            k=k+1
        end
    end
    enemy.state=0
    enemy.state_time=0
    enemy.cooldown=0.5
    enemy_dash_active=0
    enemy_dash_t=0
    enemy_dash_hit=0
    enemy_super_windup=0
    enemy_super_kind=0
    ds_log("enemy azum revived")
    return 1
end
public function enemy_start_snow()
    enemy_gift.x=enemy.x
    enemy_gift.y=enemy.y
    local number a=atan2(player.y-enemy.y,player.x-enemy.x)
    enemy_gift.dx=cos(a)
    enemy_gift.dy=sin(a)
    enemy_gift.active=1
    enemy_gift.t=0
    enemy_gift.shot=enemy_gift.shot+1
    enemy_gift.pierce=0
    ds_log("enemy snow thrown")
end
public function enemy_snow_explode()
    enemy_gift.active=0
    enemy_boom_x=enemy_gift.x
    enemy_boom_y=enemy_gift.y
    enemy_boom_t=boom_time
    if dist(enemy_boom_x,enemy_boom_y,player.x,player.y)<=super_radius then
        if revive_prot<=0 then
            if player_freeze<santa_freeze_time_for(enemy_level) then
                player_freeze=santa_freeze_time_for(enemy_level)
                player_freeze_slow=super_freeze_slow
            end
            take_damage(santa_super_damage)
            if player.hp<=0 then
                player.hp=0
                if try_revive()==0 then
                    finish_game(2)
                end
            end
        end
    end
end
public function tick_enemy_gift()
    if enemy_boom_t>0 then
        enemy_boom_t=enemy_boom_t-dt
        if enemy_boom_t<0 then
            enemy_boom_t=0
        end
    end
    if enemy_gift.active==0 then
        return
    end
    if finished!=0 then
        enemy_gift.active=0
        return
    end
    enemy_gift.t=enemy_gift.t+dt
    enemy_gift.x=enemy_gift.x+enemy_gift.dx*super_speed*dt
    enemy_gift.y=enemy_gift.y+enemy_gift.dy*super_speed*dt
    snow_chip_player_turrets()
    local number touched=0
    if dist(enemy_gift.x,enemy_gift.y,player.x,player.y)<player.size*0.65+24 then
        touched=1
    end
    if enemy_gift.t>super_range/super_speed then
        touched=1
    end
    if touched==1 then
        enemy_snow_explode()
    end
end
public function draw_enemy_gift()
    if enemy_gift.active==0 then
        return
    end
    local number hw=16, rot=enemy_gift.t*3
    tex(enemy_gift.x-hw,enemy_gift.y-hw,SNOWFLAKE_TEX,rot,0.5)
end
public function draw_enemy_boom()
    draw_boom_at(enemy_boom_x,enemy_boom_y,enemy_boom_t)
end
