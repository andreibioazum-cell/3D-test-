public function azum_idle_tex()
    if azum_tex_ok==1 then
        return AZUM_TEX
    end
    return ORDINARY_TEX
end
-- У удара Азума своя текстура, и проверять надо именно её: раньше здесь
-- стоял флаг СТОЙКИ (azum_tex_ok), поэтому при нехватке одного из двух файлов
-- боец на стойке и в ударе рисовался по-разному - например, в стойке обычным
-- кубом, а в ударе зомби.
public function azum_punch_tex()
    if azum_punch_tex_ok==1 then
        return AZUM_PUNCH_TEX
    end
    return PUNCH_TEX
end
-- Скин зомби включается, только когда загрузились ОБЕ его текстуры: иначе
-- получалась «фигня» - в ударе зомби, а в стойке обычный куб.
public function zombie_tex_ok()
    if azum_zombie_tex_ok==0||azum_zombie_punch_tex_ok==0 then
        return 0
    end
    if png_load(AZUM_ZOMBIE_TEX)==0||png_load(AZUM_ZOMBIE_PUNCH_TEX)==0 then
        return 0
    end
    return 1
end
-- Текстура для рисования бойца: имя проверяется, и если файла нет - берём
-- запасную. tex() для незагруженной текстуры не рисует вообще ничего, поэтому
-- без такой проверки боец просто исчезал с экрана.
public function idle_tex_for(string name)
    if png_load(name)==1 then
        return name
    end
    return ORDINARY_TEX
end
public function punch_tex_for(string name)
    if png_load(name)==1 then
        return name
    end
    if png_load(PUNCH_TEX)==1 then
        return PUNCH_TEX
    end
    return ORDINARY_TEX
end
public function zombie_idle_tex()
    if azum_zombie_tex_ok==1 then
        return AZUM_ZOMBIE_TEX
    end
    return azum_idle_tex()
end
public function zombie_punch_tex()
    if azum_zombie_punch_tex_ok==1 then
        return AZUM_ZOMBIE_PUNCH_TEX
    end
    return azum_punch_tex()
end
public function class_idle_tex(number cls)
    if cls==CLASS_AZUM then
        return idle_tex_for(azum_idle_tex())
    end
    if cls==CLASS_SANTA then
        return idle_tex_for(SANTA_TEX)
    end
    if cls==CLASS_EBUC then
        return idle_tex_for(EBUC_TEX)
    end
    return ORDINARY_TEX
end
public function class_punch_tex(number cls)
    if cls==CLASS_AZUM then
        return punch_tex_for(azum_punch_tex())
    end
    if cls==CLASS_SANTA then
        return punch_tex_for(SANTA_PUNCH_TEX)
    end
    if cls==CLASS_EBUC then
        return punch_tex_for(EBUC_PUNCH_TEX)
    end
    return punch_tex_for(PUNCH_TEX)
end
public function class_punch_damage_for(number cls, number lv)
    if cls==CLASS_SANTA then
        return santa_damage
    end
    if cls==CLASS_EBUC then
        return ebuc_damage
    end
    if cls==CLASS_ORDINARY&&lv>=1 then
        return punch_damage*(1+ordinary_damage_bonus)
    end
    return punch_damage
end
public function player_max_hp_for(number cls)
    if cls==CLASS_EBUC then
        return ebuc_hp
    end
    if cls==CLASS_AZUM then
        return azum_hp
    end
    return 10
end
public function ebuc_station_hp_for(number lv)
    local number h=ebuc_station_hp
    if lv>=1 then
        h=h+ebuc_station_hp_bonus*2
    end
    return h
end
public function ebuc_universe_damage_for(number lv)
    local number d=ebuc_universe_damage
    if lv>=3 then
        d=d+ebuc_universe_damage_bonus
    end
    return d
end
public function class_punch_damage(number cls)
    return class_punch_damage_for(cls,player_level)
end
public function santa_poison_time_for(number lv)
    return santa_poison_time
end
public function santa_poison_damage_for(number lv)
    local number d=santa_poison_dps
    if lv>=1 then
        d=d+santa_poison_damage_bonus
    end
    if lv>=2 then
        d=d+santa_poison_damage_bonus
    end
    return d
end
public function santa_freeze_time_for(number lv)
    local number t=super_freeze
    if lv>=3 then
        t=t+santa_freeze_time_bonus
    end
    return t
end
