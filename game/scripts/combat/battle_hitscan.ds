public function turret_zone_half()
    return turret_hit_r
end
-- С какого расстояния от центра бойца начинается зона его удара: от края
-- корпуса. И рисунок зоны, и все проверки попадания считают этот отступ
-- одинаково, поэтому визуальная зона совпадает с настоящей.
public function punch_front_offset(number size)
    if size<0 then
        size=0
    end
    return size*punch_front_scale
end
public function turret_square_dist(number tx, number ty, number x, number y)
    local number dx=fabs(x-tx)-turret_zone_half()
    local number dy=fabs(y-ty)-turret_zone_half()
    if dx<0 then
        dx=0
    end
    if dy<0 then
        dy=0
    end
    if dx>dy then
        return dx
    end
    return dy
end
public function turret_square_seg_dist(number sx, number sy, number dx, number dy, number len, number tx, number ty)
    local number best=turret_square_dist(tx,ty,sx,sy)
    local number step=turret_zone_half()
    if step<=0 then
        step=1
    end
    local number off=0
    while off<=len do
        local number d=turret_square_dist(tx,ty,sx+dx*off,sy+dy*off)
        if d<best then
            best=d
        end
        off=off+step
    end
    local number de=turret_square_dist(tx,ty,sx+dx*len,sy+dy*len)
    if de<best then
        best=de
    end
    return best
end
public function punch_resolve_target(number px, number py, number pdx, number pdy, number expand_player, number front)
    local number best=-1, bfw=0, i=0
    local number pr=expand_player
    if pr<0 then
        pr=0
    end
    if front<0 then
        front=0
    end
    local number half=punch_width/2+pr
    local number rx=player.x-px, ry=player.y-py
    local number fw=rx*pdx+ry*pdy, side=ry*pdx-rx*pdy
    if fw>=0&&fw<=punch_reach+pr+front&&side*side<=half*half then
        best=0
        bfw=fw
    end
    local number th=punch_width/2+turret_zone_half()
    local number back=turret_zone_half()
    while i<turret_max do
        if turret_alive(i)==1 then
            local number hx=arr_get(turret_x,i)-px, hy=arr_get(turret_y,i)-py
            local number tf=hx*pdx+hy*pdy, ts=hy*pdx-hx*pdy
            if tf>=0-back&&tf<=punch_reach+back+front&&fabs(ts)<=th then
                if best==-1 then
                    best=i+1
                    bfw=tf
                else if best==0 then
                    if tf<=bfw+30 then
                        best=i+1
                        bfw=tf
                    end
                else if tf<bfw-1 then
                    best=i+1
                    bfw=tf
                end
            end
        end
        i=i+1
    end
    return best
end
public function seg_dist(number sx, number sy, number dx, number dy, number len, number tx, number ty)
    local number ex=sx+dx*len, ey=sy+dy*len
    local number wx=tx-sx, wy=ty-sy
    local number c=wx*dx+wy*dy
    if c<=0 then
        return sqrt(wx*wx+wy*wy)
    end
    if c>=len then
        return sqrt((tx-ex)*(tx-ex)+(ty-ey)*(ty-ey))
    end
    local number px=sx+dx*c, py=sy+dy*c
    return sqrt((tx-px)*(tx-px)+(ty-py)*(ty-py))
end
public function dash_hit_radius_solo()
    return (player.size*0.65+enemy.size*0.65+12)*dash_hit_radius_scale
end
public function dash_hit_radius_remote()
    return (player.size*0.65+14)*dash_hit_radius_scale
end
public function dash_resolve_target(number sx, number sy, number dx, number dy, number len)
    local number best=-1, bd=0
    local number pr=dash_hit_radius_remote()
    local number d=seg_dist(sx,sy,dx,dy,len,player.x,player.y)
    if d<=pr then
        best=0
        bd=d
    end
    local number i=0
    while i<turret_max do
        if turret_alive(i)==1 then
            local number r=8
            local number td=turret_square_seg_dist(sx,sy,dx,dy,len,arr_get(turret_x,i),arr_get(turret_y,i))
            if td<=r then
                if best==-1 then
                    best=i+1
                    bd=td
                else if best==0 then
                    if td<=bd+20 then
                        best=i+1
                        bd=td
                    end
                else if td<bd-1 then
                    best=i+1
                    bd=td
                end
            end
        end
        i=i+1
    end
    return best
end
