function draw_remote_snow()
    number s=0
    loop s<max_players
        number b=s*snow_fields
        if arr_get(remote_snow,b+1)==1
            number x=arr_get(remote_snow,b+3), y=arr_get(remote_snow,b+4), t=arr_get(remote_snow,b+2)
            number hw=16
            tex(x-hw,y-hw,SNOWFLAKE_TEX,t*3,0.5)
        end
        if arr_get(remote_snow,b+5)>0
            draw_boom_at(arr_get(remote_snow,b+6),arr_get(remote_snow,b+7),arr_get(remote_snow,b+5))
        end
        s=s+1
    end
end
function finish_game(number result)
    finished=result
    aim_id=-1
    super_id=-1
    punch.active=0
    punch.hit=0
    punch_left=0
    super_windup=0
    santa_follow=0
    drop_joy()
    gift.active=0
    card_active=0
    boom_t=0
    dash_active=0
    dash_t=0
    dash_hit=0
    dash_pub=0
    enemy_gift.active=0
    enemy_boom_t=0
    enemy_dash_active=0
    enemy_dash_t=0
    enemy_dash_hit=0
    enemy_super_windup=0
    enemy_super_kind=0
    turret_heal_t=0
    universe_active=0
    universe_a=0
    keyboard_hide()
    number i=0
    loop i<max_players
        number sb=i*snow_fields
        arr_set(remote_snow,sb,0)
        arr_set(remote_snow,sb+1,0)
        arr_set(remote_snow,sb+5,0)
        number tb=i*station_fields
        number k=0
        loop k<turret_max
            arr_set(remote_station,tb+1+k*5,0)
            k=k+1
        end
        number ub=i*universe_fields
        arr_set(remote_universe,ub,0)
        arr_set(remote_universe,ub+1,0)
        number db=i*dash_fields
        arr_set(remote_dash,db,0)
        arr_set(remote_dash,db+1,0)
        i=i+1
    end
    if result==1&&cups_awarded==0
        cups_awarded=1
        cups=cups+cup_win
        if candy_enabled==1
            candies=candies+candy_win
        end
        save_progress()
        grant_achievement(ACH_FIRST_WIN)
        quest_on_win(result)
        ds_log("win +%g cups +%g candies",cup_win,candy_win)
    end
    if result==2&&cups_awarded==0
        cups_awarded=1
        cups=cups-cup_lose
        if cups<0
            cups=0
        end
        save_progress()
        quest_on_win(result)
        ds_log("lose -%g cups",cup_lose)
    end
end
function draw_punch_box(number x, number y, number dx, number dy, number reach, number width, number alpha)
    number aa=floor(clamp(alpha,0,1)*aim_max_alpha)
    if aa>0
        line(x,y,x+dx*reach,y+dy*reach,width,(((unsigned)(int)aa)<<24)|((unsigned)(int)hitbox_gray_rgb))
    end
end
function fighter_sprite(number cls, number punching, number skin)
    if skin_is_active(cls,skin)==1
        if punching==1
            return zombie_punch_tex()
        end
        return zombie_idle_tex()
    end
    if punching==1
        return class_punch_tex(cls)
    end
    return class_idle_tex(cls)
end
function draw_fighter_shadow(number x, number y, number ang, number cls, number punching, number skin)
    number hw=25*cube_scale*player_scale, ps=cube_scale*player_scale
    tex_tint(x-hw-shadow_off,y-hw+shadow_off,fighter_sprite(cls,punching,skin),sprite_a(ang),ps,(((unsigned)(int)shadow_alpha)<<24))
end
function draw_fighter_body(number x, number y, number ang, number cls, number punching, number skin)
    number hw=25*cube_scale*player_scale, ps=cube_scale*player_scale
    number sx=x-hw, sy=y-hw
    string t=fighter_sprite(cls,punching,skin)
    tex(sx,sy,t,sprite_a(ang),ps)
end
function draw_player_shadow(number x, number y, number ang, number punching, number skin)
    draw_fighter_shadow(x,y,ang,player_class,punching,skin)
end
function draw_player_body(number x, number y, number ang, number punching)
    draw_fighter_body(x,y,ang,player_class,punching,azum_skin)
end
function draw_remote_shadow(number x, number y, number ang, number cls, number punching, number skin)
    draw_fighter_shadow(x,y,ang,cls,punching,skin)
end
function draw_remote_body(number x, number y, number ang, number cls, number punching, number skin)
    draw_fighter_body(x,y,ang,cls,punching,skin)
end
function draw_field()
    rect(0,0,screen_w,screen_h,0x33000000)
end
function draw_player_shadow_layer()
    if punch_left>0
        draw_player_shadow(player.x,player.y,player.angle,1,azum_skin)
    else
        draw_player_shadow(player.x,player.y,player.angle,0,azum_skin)
    end
end
function draw_player_hitbox_layer()
    if show_hitboxes==0
        return
    end
    if aim_a>0
        draw_punch_box(player.x,player.y,cos(player.angle),sin(player.angle),punch_reach,punch_width,aim_a)
    end
end
function draw_player_body_layer()
    if punch_left>0
        draw_player_body(player.x,player.y,player.angle,1)
    else
        draw_player_body(player.x,player.y,player.angle,0)
    end
end
function enemy_punching_now()
    if enemy.state==1||enemy.state==2
        return 1
    end
    if enemy_super_windup>0
        return 1
    end
    return 0
end
function enemy_battle_tex()
    if enemy_punching_now()==1
        return class_punch_tex(enemy_class)
    end
    return class_idle_tex(enemy_class)
end
function draw_enemy_shadow()
    number ehw=25*cube_scale*enemy_scale, es=cube_scale*enemy_scale
    tex_tint(enemy.x-ehw-shadow_off,enemy.y-ehw+shadow_off,enemy_battle_tex(),sprite_a(enemy.angle),es,(((unsigned)(int)shadow_alpha)<<24))
end
function draw_enemy_hitbox()
    if show_hitboxes==0
        return
    end
    if enemy_punch_a>0
        draw_punch_box(enemy.x,enemy.y,cos(enemy.angle),sin(enemy.angle),enemy_punch_reach,enemy_punch_width,enemy_punch_a)
    end
end
function draw_enemy_body()
    number ehw=25*cube_scale*enemy_scale, es=cube_scale*enemy_scale
    tex(enemy.x-ehw,enemy.y-ehw,enemy_battle_tex(),sprite_a(enemy.angle),es)
end
function draw_controls()
    ring(joy.x,joy.y,joy.r,4,0x000000)
    circle(joy.x+joy.ox,joy.y+joy.oy,34,0x000000)
    circle(atk_x,atk_y,70,0xE94560)
    ring(atk_x,atk_y,70,4,0x000000)
    text_in_box(tr_punch(),atk_x-70,atk_y-70,140,140,0xFFFFFF,0.55)
    if (player_class==CLASS_AZUM||player_class==CLASS_SANTA||player_class==CLASS_EBUC)&&(game_state==ST_SOLO||game_state==ST_ONLINE)
        circle(atk2_x,atk2_y,70,0x5F10A0)
        ring(atk2_x,atk2_y,70,4,0x000000)
        string sl=tr_super()
        if player_class==CLASS_EBUC
            sl=tr_super_ebuc()
        else if player_class==CLASS_AZUM
            sl=tr_super_azum()
        end
        number sls=0.55
        number left=super_cd
        if player_class==CLASS_AZUM
            left=dash_cd
        end
        if left>0
            sl=floor(left+0.999)+""
            sls=0.95
        end
        text_in_box(sl,atk2_x-70,atk2_y-70,140,140,0xFFFFFF,sls)
    end
    draw_back()
end
function draw_result(string title)
    rect(0,0,screen_w,screen_h,0x99000000)
    number w=430, h=250
    number x=(screen_w-w)/2, y=screen_h/2-h/2
    roundrect(x,y,w,h,30,0x5F10A0)
    number reward=0
    if finished==1
        reward=cup_win
    else if finished==2
        reward=0-cup_lose
    end
    ctext_scaled(title,y+36,0xFFFFFF,1.12)
    if finished==2
        ctext_scaled(tr_cups_lose(reward),y+126,0xFFFFFF,0.9)
    else
        ctext_scaled(tr_cups_reward(reward),y+126,0xFFFFFF,0.9)
    end
    ctext_scaled(tr_tap_to_return(),y+188,0xFFFFFF,0.62)
end
function draw_dash_streak()
    return
end
function draw_remote_dash()
    return
end
function draw_game()
    draw_arena_background()
    draw_field()
    draw_dust()
    draw_player_shadow_layer()
    draw_enemy_shadow()
    draw_turret_shadows()
    draw_candies()
    draw_card_item()
    draw_player_hitbox_layer()
    draw_enemy_hitbox()
    draw_ability_hitboxes()
    draw_gift()
    draw_boom()
    draw_enemy_gift()
    draw_enemy_boom()
    draw_universe()
    draw_station()
    draw_enemy_turrets()
    draw_player_body_layer()
    draw_enemy_body()
    draw_freeze()
    draw_poison()
    draw_stun()
    draw_player_freeze()
    draw_player_poison()
    draw_player_stun()
    draw_dash_streak()
    draw_snow()
    number w=screen_w/4
    hud_bar(20,20,w,28,player.hp,player.max_hp,0x7ED321,0)
    hud_bar(screen_w-w-20,20,w,28,enemy.hp,enemy.max_hp,0xE94560,1)
    draw_controls()
    if finished==1
        draw_result(tr_victory())
    else if finished==2
        draw_result(tr_defeat())
    end
    draw_card_open()
end
