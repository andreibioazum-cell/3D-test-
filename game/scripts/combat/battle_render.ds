function draw_candies()
    if candy_enabled==0
        return
    end
    number i=0, cp=0, p=0, pop=0, q=0, sc=0, hw=0
    loop i<candy_count
        cp=arr_get(candy_pick,i)
        if cp>0
            // Сбор: сжимается и проворачивается, как «в обратную сторону» от появления.
            q=cp/candy_pick_time
            sc=candy_scale*q
            if sc>0.02
                hw=25*sc
                tex(arr_get(candy_x,i)-hw,arr_get(candy_y,i)-hw,CANDY_TEX,(1-q)*2*pi,sc)
            end
        else
            // Появление: как Дед Мороз — за candy_pop_time дорастает с оборотом.
            p=clamp(arr_get(candy_t,i)/candy_pop_time,0,1)
            pop=1-(1-p)*(1-p)
            sc=candy_scale*pop
            if sc>0.02
                hw=25*sc
                tex(arr_get(candy_x,i)-hw,arr_get(candy_y,i)-hw,CANDY_TEX,(1-pop)*2*pi,sc)
            end
        end
        i=i+1
    end
end
function draw_stun()
    if stun_a<=0
        return
    end
    number fa=stun_a*255
    number af=floor(fa*0.3)
    if af<=0
        return
    end
    number half=enemy.size+14
    number fill=(((unsigned)(int)af)<<24)|0x00F9A825
    number ar=floor(fa*0.7)
    number rim=(((unsigned)(int)ar)<<24)|0x00FFD54F
    circle(enemy.x,enemy.y,half,fill)
    ring(enemy.x,enemy.y,half,2,rim)
end
