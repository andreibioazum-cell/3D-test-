-- 3D-платформер: отрисовка и ввод (логика мира — в game3d/platformer.ds).
--
-- Слои кадра задаются порядком вызовов: сначала 2D-небо с солнцем и облаками,
-- затем 3D-мир (платформы, флаг, монеты, тень, игрок), затем HUD. Первая
-- 2D-команда после 3D-вызовов выдаёт очередь граней, поэтому дополнительный
-- flush3d в конце не обязателен — он стоит для cadров без HUD.
--
-- Ввод: «Назад» сверху, круглая кнопка прыжка справа, правая свободная
-- половина экрана крутит камеру перетаскиванием, слева — джойстик движения
-- (joy_touch из combat/battle_events_input.ds).

public function p3d_box_color(number kind)
    if kind == 0 then
        return 0xFF9C6B3F
    end
    if kind == 1 || kind == 2 then
        return 0xFFB3543F
    end
    if kind == 3 then
        return 0xFF3A7BD5
    end
    return 0xFF2E9E4F
end

public function p3d_draw()
    -- Небо и солнце (2D, позади всего мира).
    rect(0, 0, screen_w, screen_h, 0xFF87CEEB)
    circle(screen_w * 0.82, screen_h * 0.18, 64, 0xFFFDF3B0)
    circle(screen_w * 0.82, screen_h * 0.18, 44, 0xFFFFF9DA)
    local number cl = 0
    while cl < 3 do
        local number cx = mod(p3d_t * 12 + cl * 430, screen_w + 340) - 170
        local number cy = screen_h * (0.12 + 0.09 * cl)
        circle(cx, cy, 34, 0xCCFFFFFF)
        circle(cx + 30, cy + 8, 26, 0xCCFFFFFF)
        circle(cx - 30, cy + 10, 22, 0xCCFFFFFF)
        cl = cl + 1
    end

    -- Мир: платформы, флаг финиша, монеты, игрок (3D-слой).
    local number i = 0
    while i < p3d_count do
        local number kind = arr_get(p3d_kind, i)
        cube3d(arr_get(p3d_cx, i), arr_get(p3d_by, i), arr_get(p3d_cz, i),
               arr_get(p3d_hx, i) * 2, arr_get(p3d_hy, i) * 2, arr_get(p3d_hz, i) * 2,
               p3d_box_color(kind))
        if kind == 3 then
            -- Плита чекпоинта: активный светится голубым.
            local number mark = 0xFF244E86
            if p3d_cp == i then
                mark = 0xFF4FC3F7
            end
            cube3d(arr_get(p3d_cx, i), arr_get(p3d_by, i) + arr_get(p3d_hy, i) + 0.03,
                   arr_get(p3d_cz, i), arr_get(p3d_hx, i) * 1.15, 0.05, arr_get(p3d_hz, i) * 1.15, mark)
        end
        if kind == 4 then
            -- Флаг на финишной площадке.
            line3d(arr_get(p3d_cx, i), arr_get(p3d_by, i) + arr_get(p3d_hy, i),
                   arr_get(p3d_cz, i) - 1.8,
                   arr_get(p3d_cx, i), arr_get(p3d_by, i) + arr_get(p3d_hy, i) + 3.2,
                   arr_get(p3d_cz, i) - 1.8, 4, 0xFFE8E8E8)
            cube3d(arr_get(p3d_cx, i) + 0.9, arr_get(p3d_by, i) + arr_get(p3d_hy, i) + 2.8,
                   arr_get(p3d_cz, i) - 1.8, 1.4, 0.8, 0.1, 0xFFE94560)
        end
        i = i + 1
    end
    local number c = 0
    while c < p3d_coins_total do
        if arr_get(p3d_coin, c) == 1 then
            cube3d_yaw(arr_get(p3d_coin_x, c),
                       arr_get(p3d_coin_y, c) + 0.15 * sin(p3d_t * 2.4 + c),
                       arr_get(p3d_coin_z, c), 0.55, 0.55, 0.55,
                       p3d_t * 2.6 + c * 0.9, 0xFFFFD34D)
        end
        c = c + 1
    end
    -- Тень под игроком: тонкая тёмная пластина на опоре.
    if p3d_stand >= 0 then
        local number j = p3d_stand
        local number top = arr_get(p3d_by, j) + arr_get(p3d_hy, j)
        cube3d(p3d_px, top + 0.015, p3d_pz, 0.8, 0.02, 0.8, 0x5A000000)
    end
    cube3d_yaw(p3d_px, p3d_py, p3d_pz, 0.9, 0.9, 0.9, p3d_angle, 0xFFE94560)
    flush3d()

    -- HUD: таймер, монеты, падения, кнопки.
    local number mm = floor(p3d_time / 60)
    local number ss = floor(p3d_time - mm * 60)
    local string st = mm + ":"
    if ss < 10 then
        st = st + "0"
    end
    st = st + ss
    ctext_scaled(st, 92, text_color, 0.8)
    circle(60, 118, 15, 0xFFFFD34D)
    text_scaled(p3d_coins + "/" + p3d_coins_total, 86, 106, text_color, 0.62)
    local string fd = tr_p3d_falls() + ": " + p3d_deaths
    text_scaled(fd, screen_w - 60 - text_ink_width(fd) * 0.55, 34, text_color, 0.55)
    draw_back()
    ring(joy.x, joy.y, joy.r, 4, 0x000000)
    circle(joy.x + joy.ox, joy.y + joy.oy, 34, 0x000000)
    circle(p3d_atk_x, p3d_atk_y, 70, 0x4FC3F7)
    ring(p3d_atk_x, p3d_atk_y, 70, 4, 0x000000)
    text_in_box(tr_p3d_jump(), p3d_atk_x - 70, p3d_atk_y - 70, 140, 140, 0xFFFFFF, 0.42)
    if p3d_flash > 0 then
        rect(0, 0, screen_w, screen_h, floor(p3d_flash * 110) * 0x1000000 + 0xFF0000)
    end
    if p3d_finished == 1 then
        local number a = clamp(p3d_finish_t * 2, 0, 0.72)
        rect(0, 0, screen_w, screen_h, floor(a * 255) * 0x1000000)
        ctext_scaled(tr_p3d_win(), screen_h * 0.3, 0xFF7ED321, 1.2)
        local string s1 = tr_p3d_coins() + ": " + p3d_coins + "/" + p3d_coins_total
        local string s2 = tr_p3d_time() + ": " + st
        local string s3 = tr_p3d_falls() + ": " + p3d_deaths
        ctext_scaled(s1, screen_h * 0.3 + 90, text_color, 0.7)
        ctext_scaled(s2, screen_h * 0.3 + 130, text_color, 0.7)
        ctext_scaled(s3, screen_h * 0.3 + 170, text_color, 0.7)
        if p3d_finish_t > 0.9 then
            ctext_scaled(tr_p3d_tap(), screen_h * 0.3 + 240, text_color, 0.55)
        end
    end
end

public function p3d_touch(number x, number y, number action, number id)
    if p3d_finished == 1 then
        if action == 0 && p3d_finish_t > 0.9 then
            start_transition(ST_LOBBY)
        end
        return
    end
    if action == 3 then
        p3d_jump_id = -1
        p3d_drag_id = -1
        drop_joy()
        return
    end
    if back_hit(x, y) == 1 && action == 0 then
        start_transition(ST_LOBBY)
        return
    end
    -- Кнопка прыжка: нажатие ставит буфер (срабатывает в p3d_update).
    if action == 0 && sqrt((x - p3d_atk_x) * (x - p3d_atk_x) + (y - p3d_atk_y) * (y - p3d_atk_y)) <= 96 then
        p3d_jump_id = id
        p3d_buf_t = p3d_t
        return
    end
    if action == 1 && id == p3d_jump_id then
        p3d_jump_id = -1
        return
    end
    -- Правая половина экрана (вне кнопок) — поворот камеры перетаскиванием.
    if action == 0 && p3d_drag_id == -1 && x > screen_w * 0.45 then
        p3d_drag_id = id
        p3d_drag_x = x
        return
    end
    if action == 2 && id == p3d_drag_id then
        p3d_cam_yaw = p3d_cam_yaw + (x - p3d_drag_x) * 0.008
        p3d_drag_x = x
        return
    end
    if action == 1 && id == p3d_drag_id then
        p3d_drag_id = -1
        return
    end
    joy_touch(x, y, action, id)
end

public function p3d_back()
    start_transition(ST_LOBBY)
    return 1
end
