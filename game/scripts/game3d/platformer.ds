-- 3D-платформер от третьего лица: игрок — куб, курс из парящих платформ.
--
-- Всё рисование идёт через новый 3D-слой движка (cam3d/cube3d/cube3d_yaw/
-- line3d из native/graphics/render3d.inc): камера задаётся в p3d_update раз
-- за кадр (третье лицо: глаз позади и выше игрока, смотрит вперёд по курсу),
-- платформы, монеты и сам игрок — кубы; флаг финиша и «луч» курсора — line3d.
-- HUD (небо, кнопки, надписи) остаётся обычными 2D-командами: слои задаются
-- порядком вызовов — небо, затем 3D-мир, затем интерфейс.
--
-- Мир: ось Y — вверх, курс построен вдоль +Z. Физика — AABB: игрок размером
-- 0.9, платформы — коробки; ходьба, прыжок и двойной прыжок, «койот-время»,
-- буфер прыжка, движущиеся платформы (игрок на них едет), две контрольные
-- точки, монеты, падение за пределы мира = возврат на чекпоинт. Управление:
-- джойстик слева (как в бою), правая половина экрана — поворот камеры
-- перетаскиванием, круглая кнопка справа — прыжок.

public number p3d_ready=0
public array p3d_bx=arr_new(), p3d_by=arr_new(), p3d_bz=arr_new()
public array p3d_hx=arr_new(), p3d_hy=arr_new(), p3d_hz=arr_new()
public array p3d_kind=arr_new(), p3d_amp=arr_new(), p3d_spd=arr_new()
-- Текущие центры платформ (после движения этого кадра) и их дельты.
public array p3d_cx=arr_new(), p3d_cz=arr_new(), p3d_pdx=arr_new(), p3d_pdz=arr_new()
public number p3d_count=0

public number p3d_t=0
public number p3d_px=0, p3d_py=0, p3d_pz=0
public number p3d_vx=0, p3d_vy=0, p3d_vz=0
public number p3d_angle=0
public number p3d_ground=0, p3d_coyote=0, p3d_jumps=0, p3d_buf_t=-9
public number p3d_stand=-1
public number p3d_cp=0
public number p3d_deaths=0, p3d_coins=0, p3d_coins_total=0
public array p3d_coin=arr_new(), p3d_coin_x=arr_new(), p3d_coin_y=arr_new(), p3d_coin_z=arr_new()
public number p3d_finished=0, p3d_finish_t=0, p3d_time=0
public number p3d_flash=0
public number p3d_cam_yaw=0, p3d_drag_id=-1, p3d_drag_x=0
public number p3d_jump_id=-1
public number p3d_atk_x=0, p3d_atk_y=0

-- Константы мира (производные от pi из config.ds).
public number p3d_half=0.45, p3d_grav=22, p3d_jump_v=8.8, p3d_speed=5.4
public number p3d_coyote_max=0.12, p3d_buf_max=0.14, p3d_max_fall=22
public number p3d_cam_dist=7.5, p3d_cam_h=3.4, p3d_fov=58

public function p3d_add_box(number x, number y, number z, number sx, number sy, number sz, number kind, number amp, number spd)
    arr_push(p3d_bx, x)
    arr_push(p3d_by, y)
    arr_push(p3d_bz, z)
    arr_push(p3d_hx, sx / 2)
    arr_push(p3d_hy, sy / 2)
    arr_push(p3d_hz, sz / 2)
    arr_push(p3d_kind, kind)
    arr_push(p3d_amp, amp)
    arr_push(p3d_spd, spd)
    arr_push(p3d_cx, x)
    arr_push(p3d_cz, z)
    arr_push(p3d_pdx, 0)
    arr_push(p3d_pdz, 0)
    p3d_count = p3d_count + 1
end

public function p3d_add_coin(number x, number y, number z)
    arr_push(p3d_coin, 1)
    arr_push(p3d_coin_x, x)
    arr_push(p3d_coin_y, y)
    arr_push(p3d_coin_z, z)
    p3d_coins_total = p3d_coins_total + 1
end

public function p3d_init_world()
    if p3d_ready == 1 then
        return
    end
    p3d_ready = 1
    -- kind: 0 обычная, 1 движется по X, 2 движется по Z, 3 чекпоинт, 4 финиш.
    p3d_add_box(0, -0.5, 0, 8, 1, 8, 0, 0, 0)
    p3d_add_box(0, -0.25, 7, 3, 0.5, 3, 0, 0, 0)
    p3d_add_box(2.5, 0, 12, 3, 0.5, 3, 1, 2.5, 0.9)
    p3d_add_box(-2, 0.4, 17, 3, 0.5, 3, 0, 0, 0)
    p3d_add_box(0, 0.9, 22, 2.6, 0.5, 2.6, 2, 2.2, 1.1)
    p3d_add_box(0, 1.4, 27, 4, 0.5, 4, 3, 0, 0)
    p3d_add_box(3.2, 1.9, 32, 2.4, 0.5, 2.4, 0, 0, 0)
    p3d_add_box(-3, 2.4, 36, 2.4, 0.5, 2.4, 1, 3, 1.3)
    p3d_add_box(0, 3.0, 41, 2.2, 0.5, 2.2, 0, 0, 0)
    p3d_add_box(0, 3.5, 46, 4, 0.5, 4, 3, 0, 0)
    p3d_add_box(2, 4.0, 51, 2.2, 0.5, 2.2, 2, 2, 1.4)
    p3d_add_box(-2, 4.6, 56, 2.2, 0.5, 2.2, 0, 0, 0)
    p3d_add_box(0, 5.2, 61, 2.4, 0.5, 2.4, 1, 2, 1.6)
    p3d_add_box(0, 5.8, 67, 6, 0.6, 6, 4, 0, 0)
    p3d_add_coin(0, 1.2, 3.5)
    p3d_add_coin(2.5, 1.6, 12)
    p3d_add_coin(-2, 2.0, 17)
    p3d_add_coin(0, 2.5, 22)
    p3d_add_coin(3.2, 3.4, 32)
    p3d_add_coin(-3, 3.9, 36)
    p3d_add_coin(0, 6.8, 61)
end

-- Точка возрождения: центр верхней грани текущего чекпоинта.
public function p3d_spawn(number idx)
    local number i = p3d_cp
    if idx >= 0 then
        i = idx
    end
    p3d_px = arr_get(p3d_bx, i)
    p3d_pz = arr_get(p3d_bz, i)
    p3d_py = arr_get(p3d_by, i) + arr_get(p3d_hy, i) + p3d_half + 0.02
    p3d_vx = 0
    p3d_vy = 0
    p3d_vz = 0
    p3d_stand = -1
    p3d_ground = 0
    p3d_jumps = 0
    p3d_angle = 0
    p3d_cam_yaw = 0
end

public function p3d_start()
    p3d_init_world()
    local number i = 0
    while i < p3d_coins_total do
        arr_set(p3d_coin, i, 1)
        i = i + 1
    end
    p3d_coins = 0
    p3d_deaths = 0
    p3d_time = 0
    p3d_t = 0
    p3d_flash = 0
    p3d_finished = 0
    p3d_finish_t = 0
    p3d_cp = 0
    p3d_buf_t = -9
    joy_id = -1
    p3d_jump_id = -1
    p3d_drag_id = -1
    drop_joy()
    joy.x = 130
    joy.y = screen_h - 150
    joy.r = 70
    p3d_atk_x = screen_w - 110
    p3d_atk_y = screen_h - 150
    p3d_spawn(0)
end

-- Плавный доворот угла по кратчайшей дуге.
public function p3d_lerp_angle(number a, number b, number k)
    local number d = b - a
    while d > pi do
        d = d - 2 * pi
    end
    while d < -pi do
        d = d + 2 * pi
    end
    return a + d * k
end

-- Движение платформ этого кадра: новые центры и дельты за dt.
public function p3d_move_platforms()
    local number i = 0
    while i < p3d_count do
        local number kind = arr_get(p3d_kind, i)
        local number amp = arr_get(p3d_amp, i), spd = arr_get(p3d_spd, i)
        local number ox = 0, oz = 0, ox0 = 0, oz0 = 0
        if kind == 1 then
            ox = amp * sin(p3d_t * spd)
            ox0 = amp * sin((p3d_t - dt) * spd)
        else if kind == 2 then
            oz = amp * sin(p3d_t * spd)
            oz0 = amp * sin((p3d_t - dt) * spd)
        end
        local number base = arr_get(p3d_bx, i)
        arr_set(p3d_cx, i, base + ox)
        base = arr_get(p3d_bz, i)
        arr_set(p3d_cz, i, base + oz)
        arr_set(p3d_pdx, i, ox - ox0)
        arr_set(p3d_pdz, i, oz - oz0)
        i = i + 1
    end
end

-- Столкновение коробки игрока с платформой i по всем трём осям.
public function p3d_hit(number i, number x, number y, number z)
    if abs(x - arr_get(p3d_cx, i)) >= arr_get(p3d_hx, i) + p3d_half then
        return 0
    end
    if abs(y - arr_get(p3d_by, i)) >= arr_get(p3d_hy, i) + p3d_half then
        return 0
    end
    if abs(z - arr_get(p3d_cz, i)) >= arr_get(p3d_hz, i) + p3d_half then
        return 0
    end
    return 1
end

public function p3d_do_jump()
    p3d_vy = p3d_jump_v
    p3d_ground = 0
    p3d_coyote = 0
    p3d_stand = -1
    p3d_jumps = p3d_jumps + 1
    p3d_buf_t = -9
end

public function p3d_die()
    p3d_deaths = p3d_deaths + 1
    p3d_flash = 1
    p3d_spawn(-1)
end

public function p3d_update()
    p3d_t = p3d_t + dt
    if p3d_finished == 1 then
        p3d_finish_t = p3d_finish_t + dt
        return
    end
    p3d_time = p3d_time + dt
    p3d_flash = clamp(p3d_flash - dt * 2.2, 0, 1)
    p3d_move_platforms()

    -- Езда на платформе, на которой стояли в прошлом кадре.
    if p3d_ground == 1 && p3d_stand >= 0 then
        p3d_px = p3d_px + arr_get(p3d_pdx, p3d_stand)
        p3d_pz = p3d_pz + arr_get(p3d_pdz, p3d_stand)
    end

    -- Управление: джойстик относительно камеры (вперёд = от игрока по курсу).
    local number fw_x = sin(p3d_cam_yaw), fw_z = cos(p3d_cam_yaw)
    local number rt_x = cos(p3d_cam_yaw), rt_z = -sin(p3d_cam_yaw)
    local number wish_x = fw_x * (-joy.dy) + rt_x * joy.dx
    local number wish_z = fw_z * (-joy.dy) + rt_z * joy.dx
    local number k = clamp(14 * dt, 0, 1)
    p3d_vx = p3d_vx + (wish_x * p3d_speed - p3d_vx) * k
    p3d_vz = p3d_vz + (wish_z * p3d_speed - p3d_vz) * k
    if abs(joy.dx) + abs(joy.dy) > 0.25 then
        p3d_angle = p3d_lerp_angle(p3d_angle, atan2(p3d_vx, p3d_vz), clamp(12 * dt, 0, 1))
    end

    -- Горизонталь: ось X, затем ось Z, с выталкиванием из стен.
    p3d_px = p3d_px + p3d_vx * dt
    local number i = 0
    while i < p3d_count do
        if p3d_hit(i, p3d_px, p3d_py, p3d_pz) == 1 then
            if p3d_vx > 0 then
                p3d_px = arr_get(p3d_cx, i) - arr_get(p3d_hx, i) - p3d_half - 0.001
            else if p3d_vx < 0 then
                p3d_px = arr_get(p3d_cx, i) + arr_get(p3d_hx, i) + p3d_half + 0.001
            end
            p3d_vx = 0
        end
        i = i + 1
    end
    p3d_pz = p3d_pz + p3d_vz * dt
    i = 0
    while i < p3d_count do
        if p3d_hit(i, p3d_px, p3d_py, p3d_pz) == 1 then
            if p3d_vz > 0 then
                p3d_pz = arr_get(p3d_cz, i) - arr_get(p3d_hz, i) - p3d_half - 0.001
            else if p3d_vz < 0 then
                p3d_pz = arr_get(p3d_cz, i) + arr_get(p3d_hz, i) + p3d_half + 0.001
            end
            p3d_vz = 0
        end
        i = i + 1
    end

    -- Вертикаль: гравитация с подшагами (чтобы не проскакивать тонкие
    -- платформы при редком скачке dt), приземление и удар головой.
    p3d_vy = clamp(p3d_vy - p3d_grav * dt, -p3d_max_fall, p3d_max_fall)
    local number left = p3d_vy * dt
    local number steps = 1 + floor(abs(left) / 0.4)
    if steps > 6 then
        steps = 6
    end
    local number sy = left / steps
    local number landed = 0
    local number j = 0
    i = 0
    while i < steps do
        p3d_py = p3d_py + sy
        j = 0
        while j < p3d_count do
            if p3d_hit(j, p3d_px, p3d_py, p3d_pz) == 1 then
                if sy <= 0 then
                    -- Пришли сверху — кладём на крышку платформы.
                    p3d_py = arr_get(p3d_by, j) + arr_get(p3d_hy, j) + p3d_half + 0.001
                    p3d_vy = 0
                    landed = 1
                    p3d_stand = j
                else
                    p3d_py = arr_get(p3d_by, j) - arr_get(p3d_hy, j) - p3d_half - 0.001
                    p3d_vy = 0
                end
            end
            j = j + 1
        end
        i = i + 1
    end

    -- Опора: стоим, если под ногами крышка какой-то платформы.
    if landed == 0 then
        p3d_stand = -1
        local number s = 0
        while s < p3d_count do
            local number sdx = abs(p3d_px - arr_get(p3d_cx, s))
            local number sdz = abs(p3d_pz - arr_get(p3d_cz, s))
            local number gap = p3d_py - p3d_half - (arr_get(p3d_by, s) + arr_get(p3d_hy, s))
            if sdx < arr_get(p3d_hx, s) + p3d_half - 0.06 && sdz < arr_get(p3d_hz, s) + p3d_half - 0.06 && gap > -0.05 && gap < 0.12 then
                p3d_stand = s
                s = p3d_count
            end
            s = s + 1
        end
    end
    if p3d_stand >= 0 then
        p3d_ground = 1
        p3d_coyote = p3d_coyote_max
        p3d_jumps = 0
        -- Чекпоинт и финиш — по типу платформы под ногами.
        local number kind = arr_get(p3d_kind, p3d_stand)
        if kind == 3 && p3d_cp != p3d_stand then
            p3d_cp = p3d_stand
        end
        if kind == 4 then
            p3d_finished = 1
            p3d_finish_t = 0
        end
    else
        p3d_ground = 0
        p3d_coyote = p3d_coyote - dt
    end

    -- Прыжок: буфер нажатия + койот-время + второй прыжок в воздухе.
    if p3d_t - p3d_buf_t < p3d_buf_max then
        if p3d_ground == 1 || p3d_coyote > 0 then
            p3d_jumps = 0
            p3d_do_jump()
        else if p3d_jumps < 2 then
            p3d_do_jump()
        end
    end

    -- Монеты.
    local number c = 0
    while c < p3d_coins_total do
        if arr_get(p3d_coin, c) == 1 then
            local number cdx = abs(p3d_px - arr_get(p3d_coin_x, c))
            local number cdy = abs(p3d_py - (arr_get(p3d_coin_y, c) + 0.15 * sin(p3d_t * 2.4 + c)))
            local number cdz = abs(p3d_pz - arr_get(p3d_coin_z, c))
            if cdx < 0.8 && cdy < 0.95 && cdz < 0.8 then
                arr_set(p3d_coin, c, 0)
                p3d_coins = p3d_coins + 1
            end
        end
        c = c + 1
    end

    -- Падение в пустоту.
    if p3d_py < -9 then
        p3d_die()
        return
    end

    -- Камера от третьего лица: глаз позади игрока против направления курса.
    local number ex = p3d_px - fw_x * p3d_cam_dist
    local number ez = p3d_pz - fw_z * p3d_cam_dist
    local number ey = p3d_py + p3d_cam_h
    cam3d(ex, ey, ez, p3d_px + fw_x * 2.2, p3d_py + 1.1, p3d_pz + fw_z * 2.2, p3d_fov)
end
