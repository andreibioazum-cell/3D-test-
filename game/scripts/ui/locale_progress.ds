public function tr_level_unlock_cost(number cost)
    local string out = ""
    if language == 1 then
        out = "Открыть · " + cost + " " + tr_cups_unit()
    else
        out = "Unlock · " + cost + " " + tr_cups_unit()
    end
    return out
end
public function tr_class_level_effect(number cls, number n)
    if cls == 1 && n == 1 then
        if language == 1 then
            return "Вторая жизнь: урон -10%"
        end
        return "Second life: damage -10%"
    end
    if cls == 1 && n == 2 then
        if language == 1 then
            return "Скорость +3%"
        end
        return "Speed +3%"
    end
    if cls == 1 && n == 3 then
        if language == 1 then
            return "Атака лечит +0.1 HP"
        end
        return "Attack heals +0.1 HP"
    end
    if cls == 2 && n == 1 then
        if language == 1 then
            return "Тик яда +0.15 урона"
        end
        return "Poison tick +0.15 damage"
    end
    if cls == 2 && n == 2 then
        if language == 1 then
            return "Тик яда +0.15 урона (x2)"
        end
        return "Poison tick +0.15 damage (x2)"
    end
    if cls == 2 && n == 3 then
        if language == 1 then
            return "Яд стакается, снежинка наносит урон"
        end
        return "Poison stacks, snowflake deals damage"
    end
    if cls == 3 && n == 1 then
        if language == 1 then
            return "Турель +2 HP"
        end
        return "Turret +2 HP"
    end
    if cls == 3 && n == 2 then
        if language == 1 then
            return "Спавн турели лечит +0.5 HP"
        end
        return "Placing a turret heals +0.5 HP"
    end
    if cls == 3 && n == 3 then
        if language == 1 then
            return "Луч турели лечит +0.1 HP/сек"
        end
        return "Turret beam heals +0.1 HP/sec"
    end
    if cls == 0 && n == 1 then
        if language == 1 then
            return "Урон атаки +5%"
        end
        return "Attack damage +5%"
    end
    if cls == 0 && n == 2 then
        if language == 1 then
            return "Скорость +2%"
        end
        return "Speed +2%"
    end
    if language == 1 then
        return "Атака лечит +0.05 HP"
    end
    return "Attack heals +0.05 HP"
end
