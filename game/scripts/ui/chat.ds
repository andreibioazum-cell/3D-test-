public number chat_open=0
public number sticker_menu_open=0
public string chat_input=""
-- Стикеры: кнопка рядом с полем ввода, маленькое меню выбора. Нажатие на
-- стикер мгновенно закрывает чат и отправляет сообщение вида "/sticker <имя>"
-- — остальные клиенты вместо текста рисуют картинку из game/assets (PNG).
-- Заглушки: like.png, dislike.png, 75.png — можно заменить на свои.
public number STICKER_BTN=52
public number STICKER_TILE=64
public string STICKER_LIKE="like.png", STICKER_DISLIKE="dislike.png", STICKER_75="75.png"
public string STICKER_CMD="/sticker "
public function chat_close_x()
    return (screen_w - btn_w) / 2
end
public function chat_top_y()
    return back_y
end
public function chat_msg_top()
    return chat_top_y() + btn_h + 4
end
public function chat_input_y()
    return screen_h - 72
end
public function chat_visible_limit()
    local number ly = chat_msg_top(), iy = chat_input_y(), lh = iy - ly - 12, line_h = 28
    local number maxl = floor(lh / line_h)
    if maxl < 1 then
        maxl = 1
    end
    return maxl
end
public function chat_sync_input()
    chat_input = keyboard_get_text()
end
public function is_admin()
    if net_login_status() != 2 then
        return 0
    end
    local string nick = net_login_nick()
    local string pass = net_login_pass()
    if str_eq(nick, ADMIN_NICK) == 1 && str_eq(pass, ADMIN_PASS) == 1 then
        return 1
    end
    if str_eq(nick, ADMIN2_NICK) == 1 && str_eq(pass, ADMIN2_PASS) == 1 then
        return 1
    end
    return 0
end
public function admin_actor_nick()
    return admin_nick_of(admin_slot(net_login_nick()))
end
public function admin_handle(string msg)
    if is_admin() == 0 then
        return 0
    end
    local string by = admin_actor_nick()
    if str_eq(msg, "event 0") == 1 then
        local number cur = net_event()
        if cur == 0 then
            net_event_set(1)
            net_chat_send("DISCO EVENT by " + by + "!")
            ds_log("admin: event 0 -> disco ON")
        else
            net_event_set(0)
            net_chat_send("EVENT OFF by " + by)
            ds_log("admin: event 0 -> OFF")
        end
        return 1
    end
    if str_eq(msg, "event 1") == 1 then
        net_event_set(1)
        net_chat_send("DISCO EVENT by " + by + "!")
        ds_log("admin: event 1 disco")
        return 1
    end
    if str_eq(msg, "event 3") == 1 then
        net_event_set(3)
        net_chat_send("PLATES EVENT by " + by)
        return 1
    end
    if net_chat_is_ban(msg) == 1 then
        local string t1 = net_chat_ban_target(msg)
        if str_len(t1) > 0 then
            net_ban_set(t1, 1)
            net_chat_send(t1 + " BANNED by " + by)
            ds_log("admin ban %s", t1)
            return 1
        end
    end
    if net_chat_is_unban(msg) == 1 then
        local string t2 = net_chat_unban_target(msg)
        if str_len(t2) > 0 then
            net_ban_set(t2, 0)
            net_chat_send(t2 + " UNBANNED by " + by)
            ds_log("admin unban %s", t2)
            return 1
        end
    end
    if net_chat_is_text_cmd(msg) == 1 then
        local string btxt = net_chat_text_cmd_text(msg)
        local string bcol = net_chat_text_cmd_color(msg)
        if str_len(btxt) > 0 then
            net_banner_send(btxt, bcol)
            ds_log("admin text: %s (%s)", btxt, bcol)
            return 1
        end
    end
    return 0
end
public function chat_send()
    chat_sync_input()
    if str_len(chat_input) == 0 then
        return
    end
    if is_admin() == 1 then
        if str_eq(chat_input, "event 0") == 1 || str_eq(chat_input, "event 1") == 1 || str_eq(chat_input, "event 3") == 1 then
            admin_handle(chat_input)
            chat_input = ""
            keyboard_clear()
            return
        end
        if net_chat_is_ban(chat_input) == 1 || net_chat_is_unban(chat_input) == 1 then
            admin_handle(chat_input)
            chat_input = ""
            keyboard_clear()
            return
        end
        if net_chat_is_text_cmd(chat_input) == 1 then
            admin_handle(chat_input)
            chat_input = ""
            keyboard_clear()
            return
        end
    end
    net_chat_send(chat_input)
    ds_log("chat: %s", chat_input)
    chat_input = ""
    keyboard_clear()
    net_chat_trim(chat_visible_limit())
end
public function chat_sticker_tex(string msg)
    local string n = ""
    if str_starts_with(msg, STICKER_CMD) == 1 then
        n = str_sub(msg, 9, str_len(msg) - 9)
        if str_eq(n, STICKER_LIKE) == 1 || str_eq(n, STICKER_DISLIKE) == 1 || str_eq(n, STICKER_75) == 1 then
            return n
        end
    end
    return ""
end
public function chat_set_open(number v)
    chat_open = v
    sticker_menu_open = 0
    keyboard_hide()
end
public function chat_send_sticker(string texname)
    net_chat_send(STICKER_CMD + texname)
    ds_log("chat sticker: %s", texname)
    chat_set_open(0)
end
public function sticker_btn_x()
    local number lx = 16, lw = screen_w - 32
    return lx + lw - 112 - 8 - STICKER_BTN
end
public function sticker_menu_w()
    return 12 + 3 * STICKER_TILE + 2 * 12 + 12
end
public function sticker_menu_h()
    return 12 + STICKER_TILE + 12
end
public function sticker_menu_x()
    local number lx = 16, lw = screen_w - 32
    return lx + lw - sticker_menu_w()
end
public function sticker_menu_y()
    return chat_input_y() - sticker_menu_h() - 10
end
public function sticker_tile_x(number i)
    return sticker_menu_x() + 12 + i * (STICKER_TILE + 12)
end
public function sticker_tile_y()
    return sticker_menu_y() + 12
end
public function sticker_tex_of(number i)
    if i == 0 then
        return STICKER_LIKE
    end
    if i == 1 then
        return STICKER_DISLIKE
    end
    return STICKER_75
end
public function draw_sticker_face(number cx, number cy)
    ring(cx, cy, 13, 3, text_color)
    circle(cx - 5, cy - 4, 2.4, text_color)
    circle(cx + 5, cy - 4, 2.4, text_color)
    circle(cx, cy + 6, 5, text_color)
    rect(cx - 7, cy + 1, 14, 5, ui_purple)
end
public function draw_sticker_tile(number i)
    local number tx = sticker_tile_x(i), ty = sticker_tile_y()
    roundrect(tx, ty, STICKER_TILE, STICKER_TILE, 10, 0xFF3A3A58)
    tex(tx + 8, ty + 8, sticker_tex_of(i), 0, 0.4)
end
public function chat_update()
    if game_state != 5 || chat_open == 0 then
        return
    end
    if keyboard_visible() == 1 then
        chat_sync_input()
    end
    if keyboard_enter_pressed() == 1 then
        chat_send()
    end
    if net_chat_count() > chat_visible_limit() then
        net_chat_trim(chat_visible_limit())
    end
end
public function chat_btn_x()
    return 16
end
public function chat_btn_y()
    return 108
end
public function chat_btn_w()
    return btn_w
end
public function chat_btn_h()
    return btn_h
end
public function draw_chat()
    if game_state != 5 then
        return
    end
    if chat_open == 0 then
        button(tr_chat(), chat_btn_x(), chat_btn_y(), chat_btn_w(), chat_btn_h())
        return
    end
    screen_fill()
    local number cx = chat_close_x()
    button(tr_close(), cx, chat_top_y(), btn_w, btn_h)
    local number lx = 16, lw = screen_w - 32, iy = chat_input_y(), ih = 52, ly = chat_msg_top(), line_h = 28
    local number maxl = chat_visible_limit()
    if net_chat_count() > maxl then
        net_chat_trim(maxl)
    end
    local number total = net_chat_count(), start = total - maxl
    if start < 0 then
        start = 0
    end
    if total == 0 then
        text_scaled(tr_no_messages(), lx, ly, text_color, 0.5)
    else
        local number idx = start, yy = ly
        while idx < total do
            if yy + line_h > iy - 8 then
                idx = total
            else
                local string uid = net_chat_uid(idx)
                local string st = chat_sticker_tex(net_chat_text(idx))
                if str_len(st) > 0 then
                    tex(lx + 8, yy + (line_h - 24) / 2, st, 0, 0.24)
                else
                    draw_nick_msg(uid, ": " + net_chat_text(idx), lx, yy, text_color, 0.5)
                end
                yy = yy + line_h
                idx = idx + 1
            end
        end
    end
    roundrect(lx, iy, lw - 122, ih, 10, card_bg)
    chat_sync_input()
    local string shown = chat_input
    if keyboard_visible() == 1 then
        shown = chat_input + "|"
    end
    if str_len(chat_input) == 0 && keyboard_visible() == 0 then
        text_in_field(tr_type_message(), lx + 10, iy, ih, text_color, 0.55)
    else if str_len(shown) == 0 then
        text_in_field("|", lx + 10, iy, ih, text_color, 0.55)
    else
        text_in_field(shown, lx + 10, iy, ih, text_color, 0.55)
    end
    button_scaled(tr_send(), lx + lw - 112, iy, 112, ih, 0.5)
    roundrect(sticker_btn_x(), iy, STICKER_BTN, ih, 10, ui_purple)
    draw_sticker_face(sticker_btn_x() + STICKER_BTN / 2, iy + ih / 2)
    if sticker_menu_open == 1 then
        roundrect(sticker_menu_x(), sticker_menu_y(), sticker_menu_w(), sticker_menu_h(), 12, card_bg)
        local number st_i = 0
        while st_i < 3 do
            draw_sticker_tile(st_i)
            st_i = st_i + 1
        end
    end
end
public function touch_chat(number x, number y, number action)
    if action != 0 then
        return 0
    end
    if chat_open == 0 then
        if hit_rect(x, y, chat_btn_x(), chat_btn_y(), chat_btn_w(), chat_btn_h()) == 1 then
            chat_set_open(1)
            return 1
        end
        return 0
    end
    if hit_rect(x, y, chat_close_x(), chat_top_y(), btn_w, btn_h) == 1 then
        chat_set_open(0)
        return 1
    end
    local number lx = 16, lw = screen_w - 32, iy = chat_input_y(), ih = 52
    if hit_rect(x, y, sticker_btn_x(), iy, STICKER_BTN, ih) == 1 then
        if sticker_menu_open == 1 then
            sticker_menu_open = 0
        else
            sticker_menu_open = 1
        end
        return 1
    end
    if sticker_menu_open == 1 then
        local number st_i = 0
        while st_i < 3 do
            if hit_rect(x, y, sticker_tile_x(st_i), sticker_tile_y(), STICKER_TILE, STICKER_TILE) == 1 then
                chat_send_sticker(sticker_tex_of(st_i))
                return 1
            end
            st_i = st_i + 1
        end
        if hit_rect(x, y, sticker_menu_x(), sticker_menu_y(), sticker_menu_w(), sticker_menu_h()) == 1 then
            return 1
        end
        sticker_menu_open = 0
        return 1
    end
    if hit_rect(x, y, lx, iy, lw - 122, ih) == 1 then
        if keyboard_visible() == 0 then
            keyboard_show()
        end
        return 1
    end
    if hit_rect(x, y, lx + lw - 112, iy, 112, ih) == 1 then
        chat_send()
        keyboard_hide()
        return 1
    end
    keyboard_hide()
    return 1
end
