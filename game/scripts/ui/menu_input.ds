function login_error_text()
    if login_status == 4
        return tr_no_connection()
    end
    if login_status == 5
        return tr_bad_nick()
    end
    if login_status == 6
        return tr_wrong_pass()
    end
    if login_status == 7
        return tr_bad_pass()
    end
    return ""
end
function draw_login_field(string label, string value, string placeholder, number y, number focused)
    text(label, login_x() + login_lab_ox, y - login_lab, text_color)
    roundrect(login_x(), y, login_w, login_fh, field_radius, card_bg)
    number caret = 0
    if focused == 1 && keyboard_visible() == 1
        caret = 1
    end
    string shown = value
    if str_len(value) == 0 && caret == 0
        shown = placeholder
    end
    if caret == 1
        shown = value + "|"
    end
    text_in_field(shown, login_x() + field_text_pad, y, login_fh, text_color, 0.6)
end
function draw_login()
    screen_fill()
    draw_login_field(tr_nick(), login_nick, tr_nick_ph(), login_nick_y(), login_field == 1)
    draw_login_field(tr_pass(), login_pass, tr_pass_ph(), login_pass_y(), login_field == 2)
    button_scaled(tr_login_btn(), login_btn_x(), login_btn_y(), login_btn_w, btn_h, 0.65)
    string err = login_error_text()
    if str_len(err) > 0
        ctext(err, login_msg_y(), text_color)
    end
    draw_back()
end
function login_sync_field()
    if keyboard_visible() == 0
        return
    end
    if login_field == 1
        login_nick = keyboard_get_text()
    else
        login_pass = keyboard_get_text()
    end
end
function login_focus(number field, string value)
    login_sync_field()
    login_field = field
    keyboard_clear()
    if str_len(value) > 0
        keyboard_type(value)
    end
    keyboard_show()
end
function login_focus_nick()
    login_focus(1, login_nick)
end
function login_focus_pass()
    login_focus(2, login_pass)
end
function login_open()
    login_field = 1
    login_status = 0
    login_nick = ""
    login_pass = ""
    keyboard_clear()
    keyboard_hide()
end
function login_do()
    login_sync_field()
    if str_len(login_nick) == 0
        login_status = 5
        keyboard_hide()
        return
    end
    if str_len(login_pass) == 0
        login_status = 7
        keyboard_hide()
        return
    end
    number res = net_auth(FIREBASE, login_nick, login_pass)
    if res != 2
        login_status = res
        return
    end
    login_status = 0
    keyboard_hide()
    keyboard_clear()
    progress_from_storage()
    settings_from_storage()
    start_transition(login_after)
end
function update_login()
    if keyboard_visible() == 1
        login_sync_field()
    end
    if keyboard_enter_pressed() == 1
        if login_field == 1
            login_focus_pass()
        else
            login_do()
        end
    end
end
function warn_rgb(number rgb)
    return (1 + floor(warn_a * 254)) * 0x1000000 + rgb
end
function draw_warning()
    rect(0, 0, screen_w, screen_h, 0xFF000000)
    color body = warn_rgb(text_color)
    number y = screen_h / 2 - 196
    ctext_scaled(tr_warn_title_en(), y, body, 1.15)
    ctext_scaled(tr_warn_en1(), y + 48, body, 0.52)
    ctext_scaled(tr_warn_en2(), y + 76, body, 0.52)
    ctext_scaled(tr_warn_en3(), y + 104, body, 0.52)
    ctext_scaled(tr_warn_en4(), y + 132, body, 0.52)
    ctext_scaled(tr_warn_title_ru(), y + 186, body, 1.15)
    ctext_scaled(tr_warn_ru1(), y + 234, body, 0.52)
    ctext_scaled(tr_warn_ru2(), y + 262, body, 0.52)
    ctext_scaled(tr_warn_ru3(), y + 290, body, 0.52)
    ctext_scaled(tr_warn_ru4(), y + 318, body, 0.52)
end
function studio_rgb(number rgb)
    return (1 + floor(studio_a * 254)) * 0x1000000 + rgb
end
function studio_bg_rgb(number rgb)
    return (1 + floor(studio_bg_a * 254)) * 0x1000000 + rgb
end
function draw_studio()
    rect(0, 0, screen_w, screen_h, studio_bg_rgb(0))
    color body = studio_rgb(text_color)
    number y = screen_h / 2 - 30
    ctext_scaled(STUDIO_NAME, y, body, 1.1)
    number lw = fit_w(320)
    rect(center_x(lw), y + 34, lw, 2, body)
end
function open_online()
    if net_login_status() != 2
        login_after = ST_ONLINE
        start_transition(ST_LOGIN)
        return
    end
    if net_is_banned(net_login_nick()) == 1
        banned_msg = tr_banned()
        start_transition(ST_LOBBY)
        return
    end
    start_transition(ST_ONLINE)
end
function open_leaderboard()
    lb_wait = 0
    net_leaderboard_fetch(FIREBASE)
    start_transition(ST_LEADERBOARD)
end
function touch_lobby(number x, number y, number action)
    if action != 0
        return
    end
    if hit_menu_row(x, y, 0) == 1
        start_transition(ST_MODES)
        return
    end
    if hit_menu_row(x, y, 1) == 1
        start_transition(ST_CLASSES)
        return
    end
    if hit_menu_row(x, y, 2) == 1
        start_transition(ST_SETTINGS)
        return
    end
    if hit_menu_row(x, y, 3) == 1
        login_after = ST_LOBBY
        start_transition(ST_LOGIN)
        return
    end
    if hit_menu_row(x, y, 4) == 1
        start_transition(ST_ACHIEVEMENTS)
    end
end
function touch_modes(number x, number y)
    if hit_modes_row(x, y, 0) == 1
        start_transition(ST_LOBBY)
        return
    end
    if hit_modes_row(x, y, 1) == 1
        start_transition(ST_SOLO)
        return
    end
    if hit_modes_row(x, y, 2) == 1
        open_online()
        return
    end
    if hit_modes_row(x, y, 3) == 1
        open_leaderboard()
        return
    end
    if hit_modes_row(x, y, 4) == 1
        start_transition(ST_PROMO)
        return
    end
    if hit_modes_row(x, y, 5) == 1
        quest_load()
        start_transition(ST_QUESTS)
    end
end
function touch_settings(number x, number y)
    if hit_settings_row(x, y, 0) == 1
        start_transition(ST_LOBBY)
        return
    end
    if hit_settings_row(x, y, 1) == 1
        language = 0
        save_settings()
        return
    end
    if hit_settings_row(x, y, 2) == 1
        language = 1
        save_settings()
        return
    end
    if hit_settings_row(x, y, 3) == 1
        show_hitboxes = 1 - show_hitboxes
        save_settings()
        return
    end
    if hit_settings_music_minus(x, y) == 1
        music_volume_step(-music_vol_step)
        return
    end
    if hit_settings_music_plus(x, y) == 1
        music_volume_step(music_vol_step)
        return
    end
    if hit_settings_row(x, y, 6) == 1
        fps_cap = next_fps_cap(fps_cap)
        save_settings()
        ds_set_fps_cap(fps_cap)
        return
    end
    if hit_settings_row(x, y, 7) == 1
        render_scale = next_render_scale(render_scale)
        save_settings()
        ds_set_render_scale(render_scale)
        return
    end
end
function next_fps_cap(number cur)
    if cur == 0
        return 60
    end
    if cur == 60
        return 30
    end
    return 0
end
function next_render_scale(number cur)
    if cur == 1
        return 2
    end
    if cur == 2
        return 3
    end
    return 1
end
function touch_classes(number x, number y, number action)
    if action != 0
        return
    end
    if back_hit(x, y) == 1
        start_transition(ST_LOBBY)
        return
    end
    if hit_levels_btn(x, y) == 1
        start_transition(ST_LEVELS)
        return
    end
    if hit_skins_btn(x, y) == 1
        start_transition(ST_SKINS)
        return
    end
    number vi = 0
    loop vi < classes_visible_count()
        if hit_class_card(x, y, vi) == 1
            pick_class(visible_class_at(vi))
            return
        end
        vi = vi + 1
    end
end
function touch_levels(number x, number y, number action)
    if action != 0
        return
    end
    if back_hit(x, y) == 1
        start_transition(ST_CLASSES)
        return
    end
    number n = 1
    loop n <= max_level
        if hit_level_row(x, y, n) == 1
            level_action(player_class, n)
            return
        end
        n = n + 1
    end
end
function touch_skins(number x, number y, number action)
    if action != 0
        return
    end
    if back_hit(x, y) == 1
        start_transition(ST_CLASSES)
        return
    end
    number skin = 0
    loop skin < SKIN_COUNT
        if hit_skin_card(x, y, skin) == 1
            pick_skin(skin)
            return
        end
        skin = skin + 1
    end
end
function touch_achievements(number x, number y, number action)
    if action != 0
        return
    end
    if back_hit(x, y) == 1
        start_transition(ST_LOBBY)
    end
end
function touch_leaderboard(number x, number y, number action)
    if action != 0
        return
    end
    if back_hit(x, y) == 1
        start_transition(ST_MODES)
    end
end
function touch_login(number x, number y, number action)
    if action != 0
        return
    end
    if hit_login_field(x, y, login_nick_y()) == 1
        login_focus_nick()
        return
    end
    if hit_login_field(x, y, login_pass_y()) == 1
        login_focus_pass()
        return
    end
    if hit_login_btn(x, y) == 1
        login_do()
        keyboard_hide()
        return
    end
    login_sync_field()
    keyboard_hide()
    if back_hit(x, y) == 1
        keyboard_clear()
        if login_after == ST_ONLINE
            start_transition(ST_MODES)
        else
            start_transition(ST_LOBBY)
        end
    end
end
function touch_menu(number x, number y, number action)
    if action != 0
        return
    end
    if game_state == ST_MODES
        touch_modes(x, y)
        return
    end
    if game_state == ST_SETTINGS
        touch_settings(x, y)
        return
    end
    if game_state == ST_LOGIN
        touch_login(x, y, action)
        return
    end
    if game_state == ST_CLASSES
        touch_classes(x, y, action)
        return
    end
    if game_state == ST_LEVELS
        touch_levels(x, y, action)
        return
    end
    if game_state == ST_SKINS
        touch_skins(x, y, action)
        return
    end
    if game_state == ST_ACHIEVEMENTS
        touch_achievements(x, y, action)
        return
    end
    if game_state == ST_LEADERBOARD
        touch_leaderboard(x, y, action)
        return
    end
    if game_state == ST_PROMO
        touch_promo(x, y, action)
        return
    end
    if game_state == ST_QUESTS
        touch_quests(x, y, action)
    end
end
