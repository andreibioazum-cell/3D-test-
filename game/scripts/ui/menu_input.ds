public function login_error_text()
    if login_status == 4 then
        return tr_no_connection()
    end
    if login_status == 5 then
        return tr_bad_nick()
    end
    if login_status == 6 then
        return tr_wrong_pass()
    end
    if login_status == 7 then
        return tr_bad_pass()
    end
    return ""
end
public function draw_login_field(string label, string value, string placeholder, number y, number focused)
    text(label, login_x() + login_lab_ox, y - login_lab, text_color)
    roundrect(login_x(), y, login_w, login_fh, field_radius, card_bg)
    local number caret = 0
    if focused == 1 && keyboard_visible() == 1 then
        caret = 1
    end
    local string shown = value
    if str_len(value) == 0 && caret == 0 then
        shown = placeholder
    end
    if caret == 1 then
        shown = value + "|"
    end
    text_in_field(shown, login_x() + field_text_pad, y, login_fh, text_color, 0.6)
end
public function draw_login()
    screen_fill()
    draw_login_field(tr_nick(), login_nick, tr_nick_ph(), login_nick_y(), login_field == 1)
    draw_login_field(tr_pass(), login_pass, tr_pass_ph(), login_pass_y(), login_field == 2)
    button_scaled(tr_login_btn(), login_btn_x(), login_btn_y(), login_btn_w, btn_h, 0.65)
    local string err = login_error_text()
    if str_len(err) > 0 then
        ctext(err, login_msg_y(), text_color)
    end
    draw_back()
end
public function login_sync_field()
    if keyboard_visible() == 0 then
        return
    end
    if login_field == 1 then
        login_nick = keyboard_get_text()
    else
        login_pass = keyboard_get_text()
    end
end
public function login_focus(number field, string value)
    login_sync_field()
    login_field = field
    keyboard_clear()
    if str_len(value) > 0 then
        keyboard_type(value)
    end
    keyboard_show()
end
public function login_focus_nick()
    login_focus(1, login_nick)
end
public function login_focus_pass()
    login_focus(2, login_pass)
end
public function login_open()
    login_field = 1
    login_status = 0
    login_nick = ""
    login_pass = ""
    keyboard_clear()
    keyboard_hide()
end
public function login_do()
    login_sync_field()
    if str_len(login_nick) == 0 then
        login_status = 5
        keyboard_hide()
        return
    end
    if str_len(login_pass) == 0 then
        login_status = 7
        keyboard_hide()
        return
    end
    local number res = net_auth(FIREBASE, login_nick, login_pass)
    if res != 2 then
        login_status = res
        return
    end
    login_status = 0
    keyboard_hide()
    keyboard_clear()
    progress_from_storage()
    settings_from_storage()
    start_transition(login_after)
end
public function update_login()
    if keyboard_visible() == 1 then
        login_sync_field()
    end
    if keyboard_enter_pressed() == 1 then
        if login_field == 1 then
            login_focus_pass()
        else
            login_do()
        end
    end
end
public function warn_rgb(number rgb)
    return (1 + floor(warn_a * 254)) * 0x1000000 + rgb
end
public function draw_warning()
    rect(0, 0, screen_w, screen_h, 0xFF000000)
    local color body = warn_rgb(text_color)
    local number y = screen_h / 2 - 196
    ctext_scaled(tr_warn_title_en(), y, body, 1.15)
    ctext_scaled(tr_warn_en1(), y + 48, body, 0.52)
    ctext_scaled(tr_warn_en2(), y + 76, body, 0.52)
    ctext_scaled(tr_warn_en3(), y + 104, body, 0.52)
    ctext_scaled(tr_warn_en4(), y + 132, body, 0.52)
    ctext_scaled(tr_warn_title_ru(), y + 186, body, 1.15)
    ctext_scaled(tr_warn_ru1(), y + 234, body, 0.52)
    ctext_scaled(tr_warn_ru2(), y + 262, body, 0.52)
    ctext_scaled(tr_warn_ru3(), y + 290, body, 0.52)
    ctext_scaled(tr_warn_ru4(), y + 318, body, 0.52)
    -- Кнопка согласия: вход в игру только осознанный (метка пишется в
    -- settings.dat), поэтому предупреждение нельзя проскроллить мимо.
    -- Кнопка сразу в полной яркости (как в конце), без «разгорания»; пока
    -- идёт отсчёт, в подписи держится «(N)» и нажатия не принимаются, а когда
    -- отсчёт кончается, секунды пропадают и кнопка становится доступна.
    local string label = tr_legal_accept()
    if warn_ready < 1 then
        label = label + " (" + (warn_wait - floor(warn_t)) + ")"
    end
    -- Подпись не должна вылезать за кнопку: ужимаем масштаб по ширине,
    -- но не крупнее 0.8, как было раньше.
    local number scale = fit_text_scale(label, warn_btn_w() - 24, 0.8)
    roundrect(center_x(warn_btn_w()), warn_btn_y(), warn_btn_w(), btn_h, btn_radius, 0xFF000000 + 56 * 0x010101)
    text_in_box(label, center_x(warn_btn_w()), warn_btn_y(), warn_btn_w(), btn_h, 0xFFFFFFFF, scale)
end
public function legal_accept()
    if warn_ready < 1 then
        return
    end
    warn_open = 0
    warn_a = 0
    settings_mark_legal()
    -- Заставки студии больше нет: сразу в лобби после согласия.
end
public function touch_warn(number x, number y, number action)
    if action != 0 then
        return
    end
    if hit_warn_btn(x, y) == 1 then
        legal_accept()
    end
end
public function studio_rgb(number rgb)
    return (1 + floor(studio_a * 254)) * 0x1000000 + rgb
end
public function studio_bg_rgb(number rgb)
    return (1 + floor(studio_bg_a * 254)) * 0x1000000 + rgb
end
public function draw_studio()
    rect(0, 0, screen_w, screen_h, studio_bg_rgb(0))
    local color body = studio_rgb(text_color)
    local number y = screen_h / 2 - 30
    ctext_scaled(STUDIO_NAME, y, body, 1.1)
    local number lw = fit_w(320)
    rect(center_x(lw), y + 34, lw, 2, body)
end
public function open_online()
    if net_login_status() != 2 then
        login_after = ST_ONLINE
        start_transition(ST_LOGIN)
        return
    end
    if net_is_banned(net_login_nick()) == 1 then
        banned_msg = tr_banned()
        start_transition(ST_LOBBY)
        return
    end
    start_transition(ST_ONLINE)
end
public function open_leaderboard()
    lb_wait = 0
    net_leaderboard_fetch(FIREBASE)
    start_transition(ST_LEADERBOARD)
end
public function touch_lobby(number x, number y, number action)
    if action != 0 then
        return
    end
    if hit_menu_row(x, y, 0) == 1 then
        start_transition(ST_MODES)
        return
    end
    if hit_menu_row(x, y, 1) == 1 then
        start_transition(ST_CLASSES)
        return
    end
    if hit_menu_row(x, y, 2) == 1 then
        start_transition(ST_SETTINGS)
        return
    end
    if hit_menu_row(x, y, 3) == 1 then
        login_after = ST_LOBBY
        start_transition(ST_LOGIN)
        return
    end
    if hit_menu_row(x, y, 4) == 1 then
        start_transition(ST_ACHIEVEMENTS)
        return
    end
    if hit_lobby_quests(x, y) == 1 then
        quest_load()
        start_transition(ST_QUESTS)
    end
end
public function touch_modes(number x, number y)
    if hit_modes_row(x, y, 5) == 1 then
        winter_theme = 1 - winter_theme
        apply_winter_theme()
        save_settings()
        return
    end
    if hit_modes_row(x, y, 0) == 1 then
        start_transition(ST_LOBBY)
        return
    end
    if hit_modes_row(x, y, 1) == 1 then
        start_transition(ST_SOLO)
        return
    end
    if hit_modes_row(x, y, 2) == 1 then
        open_online()
        return
    end
    if hit_modes_row(x, y, 3) == 1 then
        open_leaderboard()
        return
    end
    if hit_modes_row(x, y, 4) == 1 then
        start_transition(ST_PROMO)
    end
end
public function touch_settings(number x, number y)
    if hit_settings_row(x, y, 0) == 1 then
        start_transition(ST_LOBBY)
        return
    end
    if hit_settings_row(x, y, 1) == 1 then
        language = 0
        save_settings()
        return
    end
    if hit_settings_row(x, y, 2) == 1 then
        language = 1
        save_settings()
        return
    end
    if hit_settings_row(x, y, 3) == 1 then
        show_hitboxes = 1 - show_hitboxes
        save_settings()
        return
    end
    if hit_settings_music_minus(x, y) == 1 then
        music_volume_step(-music_vol_step)
        return
    end
    if hit_settings_music_plus(x, y) == 1 then
        music_volume_step(music_vol_step)
        return
    end
    if hit_settings_row(x, y, 6) == 1 then
        show_fps = 1 - show_fps
        save_settings()
        return
    end
    if hit_settings_row(x, y, 7) == 1 then
        start_transition(ST_PRIVACY)
        return
    end
end
public function touch_classes(number x, number y, number action)
    if action != 0 then
        return
    end
    if back_hit(x, y) == 1 then
        start_transition(ST_LOBBY)
        return
    end
    if hit_levels_btn(x, y) == 1 then
        start_transition(ST_LEVELS)
        return
    end
    if hit_skins_btn(x, y) == 1 then
        start_transition(ST_SKINS)
        return
    end
    local number vi = 0
    while vi < classes_visible_count() do
        if hit_class_card(x, y, vi) == 1 then
            pick_class(visible_class_at(vi))
            return
        end
        vi = vi + 1
    end
end
public function touch_levels(number x, number y, number action)
    if action != 0 then
        return
    end
    if back_hit(x, y) == 1 then
        start_transition(ST_CLASSES)
        return
    end
    local number n = 1
    while n <= max_level do
        if hit_level_row(x, y, n) == 1 then
            level_action(player_class, n)
            return
        end
        n = n + 1
    end
end
public function touch_skins(number x, number y, number action)
    if action != 0 then
        return
    end
    if back_hit(x, y) == 1 then
        start_transition(ST_CLASSES)
        return
    end
    local number skin = 0
    while skin < SKIN_COUNT do
        if hit_skin_card(x, y, skin) == 1 then
            pick_skin(skin)
            return
        end
        skin = skin + 1
    end
end
public function touch_achievements(number x, number y, number action)
    if action != 0 then
        return
    end
    if back_hit(x, y) == 1 then
        start_transition(ST_LOBBY)
    end
end
public function touch_leaderboard(number x, number y, number action)
    if action != 0 then
        return
    end
    if back_hit(x, y) == 1 then
        start_transition(ST_MODES)
    end
end
public function touch_login(number x, number y, number action)
    if action != 0 then
        return
    end
    if hit_login_field(x, y, login_nick_y()) == 1 then
        login_focus_nick()
        return
    end
    if hit_login_field(x, y, login_pass_y()) == 1 then
        login_focus_pass()
        return
    end
    if hit_login_btn(x, y) == 1 then
        login_do()
        keyboard_hide()
        return
    end
    login_sync_field()
    keyboard_hide()
    if back_hit(x, y) == 1 then
        keyboard_clear()
        if login_after == ST_ONLINE then
            start_transition(ST_MODES)
        else
            start_transition(ST_LOBBY)
        end
    end
end
public function touch_menu(number x, number y, number action)
    if action != 0 then
        return
    end
    if game_state == ST_MODES then
        touch_modes(x, y)
        return
    end
    if game_state == ST_SETTINGS then
        touch_settings(x, y)
        return
    end
    if game_state == ST_LOGIN then
        touch_login(x, y, action)
        return
    end
    if game_state == ST_CLASSES then
        touch_classes(x, y, action)
        return
    end
    if game_state == ST_LEVELS then
        touch_levels(x, y, action)
        return
    end
    if game_state == ST_SKINS then
        touch_skins(x, y, action)
        return
    end
    if game_state == ST_ACHIEVEMENTS then
        touch_achievements(x, y, action)
        return
    end
    if game_state == ST_LEADERBOARD then
        touch_leaderboard(x, y, action)
        return
    end
    if game_state == ST_PROMO then
        touch_promo(x, y, action)
        return
    end
    if game_state == ST_QUESTS then
        touch_quests(x, y, action)
        return
    end
    if game_state == ST_PRIVACY then
        if back_hit(x, y) == 1 then
            start_transition(ST_SETTINGS)
        end
    end
end
