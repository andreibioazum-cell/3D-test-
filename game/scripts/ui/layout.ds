end
public function hit_lobby_quests(number px, number py)
    return hit_rect_pad(px, py, lobby_quests_x(), lobby_quests_y(), btn_w, btn_h)
end
public function classes_card_w()
    local number n = classes_visible_count()
    if n < 1 then
        n = 1
    end
    local number total_gap = class_gap * (n - 1)
    local number w = (screen_w - 2 * screen_margin - total_gap) / n
    return clamp(w, class_card_min_w, class_card_max_w)
end
public function classes_total_w()
    local number n = classes_visible_count()
    if n < 1 then
        n = 1
    end
    return classes_card_w() * n + class_gap * (n - 1)
end
public function classes_top()
    return back_y + btn_h + title_gap
end
public function classes_card_x(number vi)
    return center_x(classes_total_w()) + vi * (classes_card_w() + class_gap)
end
public function class_sprite_scale()
    return 1.55
end
public function class_sprite_y()
    return classes_top() + 12
end
public function class_title_scale()
    return 0.85
end
public function class_title_y()
    return classes_top() + 82
end
public function class_desc_y()
    return classes_top() + 114
end
public function class_level_y()
    return classes_top() + 136
end
public function class_pick_inset()
    return 24
end
public function class_pick_w()
    return classes_card_w() - 2 * class_pick_inset()
end
public function class_pick_y()
    return classes_top() + class_card_h - class_pick_h - class_pick_pad
end
public function hit_class_card(number px, number py, number vi)
    return hit_rect(px, py, classes_card_x(vi), classes_top(), classes_card_w(), class_card_h)
end
public function class_actions_y()
    return classes_top() + class_card_h + class_gap
end
public function class_action_w()
    local number half = (screen_w - 2 * screen_margin - class_action_gap) / 2
    return clamp(half, 0, btn_w)
end
public function levels_btn_x()
    if player_class != CLASS_AZUM then
        return screen_w / 2 - class_action_w() / 2
    end
    return screen_w / 2 - class_action_gap / 2 - class_action_w()
end
public function skins_btn_x()
    return screen_w / 2 + class_action_gap / 2
end
public function class_has_skins(number cls)
    if cls == CLASS_AZUM then
        return 1
    end
    return 0
end
public function skins_btn_visible()
    return class_has_skins(player_class)
end
public function hit_levels_btn(number px, number py)
    return hit_rect_pad(px, py, levels_btn_x(), class_actions_y(), class_action_w(), btn_h)
end
public function hit_skins_btn(number px, number py)
    if skins_btn_visible() == 0 then
        return 0
    end
    return hit_rect_pad(px, py, skins_btn_x(), class_actions_y(), class_action_w(), btn_h)
end
public function class_msg_y()
    return class_actions_y() + btn_h + 14
end
