public function fit_w(number w)
    return clamp(w, 0, screen_w - 2 * screen_margin)
end
public function center_x(number w)
    return (screen_w - w) / 2
end
public function title_y()
    return back_y + btn_h + title_gap
end
public function content_top()
    return title_y() + list_top_gap
end
public function menu_x()
    return center_x(btn_w)
end
public function menu_stride()
    return btn_h + btn_gap
end
public function menu_top()
    return screen_h / 2 - (lobby_rows * btn_h + (lobby_rows - 1) * btn_gap) / 2
end
public function menu_row(number i)
    return menu_top() + i * menu_stride()
end
public function hit_menu_row(number px, number py, number i)
    return hit_rect_pad(px, py, menu_x(), menu_row(i), btn_w, btn_h)
end
-- Настройки: 10 строк (в лобби их 5) — центрируем отдельно, чтобы на низких
-- экранах последние строки не уходили за нижний край.
public number SETTINGS_ROWS=8
-- Шаг строк настроек: обычный (btn_h + btn_gap), но на низких экранах он
-- уменьшается ровно настолько, чтобы влезли все строки. Меньше высоты кнопки
-- шаг не становится — строки не должны наезжать друг на друга.
public function settings_stride()
    local number s = menu_stride()
    local number avail = screen_h - 16 - btn_h
    if avail < 0 then
        avail = 0
    end
    local number fit = avail / (SETTINGS_ROWS - 1)
    if fit < s then
        s = fit
    end
    if s < btn_h then
        s = btn_h
    end
    return s
end
public function settings_top()
    local number top = screen_h / 2 - (btn_h + (SETTINGS_ROWS - 1) * settings_stride()) / 2
    if top < 8 then
        top = 8
    end
    return top
end
public function settings_row_y(number i)
    return settings_top() + i * settings_stride()
end
public function hit_settings_row(number px, number py, number i)
    return hit_rect_pad(px, py, menu_x(), settings_row_y(i), btn_w, btn_h)
end
public function hit_settings_music_minus(number px, number py)
    return hit_rect_pad(px, py, music_minus_x(), settings_row_y(5), music_half_w(), btn_h)
end
public function hit_settings_music_plus(number px, number py)
    return hit_rect_pad(px, py, music_plus_x(), settings_row_y(5), music_half_w(), btn_h)
end
public function music_half_w()
    return (btn_w - music_btn_gap) / 2
end
public function music_minus_x()
    return menu_x()
end
public function music_plus_x()
    return menu_x() + btn_w - music_half_w()
end
public function hit_music_minus(number px, number py)
    return hit_rect_pad(px, py, music_minus_x(), menu_row(5), music_half_w(), btn_h)
end
public function hit_music_plus(number px, number py)
    return hit_rect_pad(px, py, music_plus_x(), menu_row(5), music_half_w(), btn_h)
end
public function lobby_title_y()
    return menu_top() - 70
end
