public number chat_bubble_time=4, chat_bubble_fade=0.6, chat_bubble_alpha=235
public number chat_bubble_pad=10, chat_bubble_h=30, chat_bubble_ink=0x00202020
public string chat_seen_key=""
public string bubble_msg0="", bubble_msg1="", bubble_msg2="", bubble_msg3=""
public number bubble_t0=0, bubble_t1=0, bubble_t2=0, bubble_t3=0
public function bubble_set(number s, string m)
    if s==0 then
        bubble_msg0=m
        bubble_t0=chat_bubble_time
    else if s==1 then
        bubble_msg1=m
        bubble_t1=chat_bubble_time
    else if s==2 then
        bubble_msg2=m
        bubble_t2=chat_bubble_time
    else if s==3 then
        bubble_msg3=m
        bubble_t3=chat_bubble_time
    end
end
public function bubble_msg(number s)
    if s==0 then
        return bubble_msg0
    else if s==1 then
        return bubble_msg1
    else if s==2 then
        return bubble_msg2
    end
    return bubble_msg3
end
public function bubble_left(number s)
    if s==0 then
        return bubble_t0
    else if s==1 then
        return bubble_t1
    else if s==2 then
        return bubble_t2
    end
    return bubble_t3
end
public function chat_bubble_show(string uid, string msg)
    if str_len(msg)==0 then
        return
    end
    local number s=net_slot()
    if str_eq(uid,net_login_nick())==1 then
        bubble_set(s,msg)
        return
    end
    local number i=0
    while i<max_players do
        if i!=s&&str_eq(uid,net_player_nick(i))==1 then
            bubble_set(i,msg)
        end
        i=i+1
    end
end
public function chat_bubbles_watch()
    if bubble_t0>0 then
        bubble_t0=bubble_t0-dt
        if bubble_t0<0 then
            bubble_t0=0
        end
    end
    if bubble_t1>0 then
        bubble_t1=bubble_t1-dt
        if bubble_t1<0 then
            bubble_t1=0
        end
    end
    if bubble_t2>0 then
        bubble_t2=bubble_t2-dt
        if bubble_t2<0 then
            bubble_t2=0
        end
    end
    if bubble_t3>0 then
        bubble_t3=bubble_t3-dt
        if bubble_t3<0 then
            bubble_t3=0
        end
    end
    if net_slot()<0 then
        return
    end
    local number cnt=net_chat_count()
    if cnt<=0 then
        return
    end
    local number last=cnt-1
    local string lastkey=net_chat_key(last)
    if str_eq(lastkey,chat_seen_key)==1 then
        return
    end
    local number starti=last
    local number k=last-1
    while k>=0 do
        if str_eq(net_chat_key(k),chat_seen_key)==1 then
            starti=k+1
            k=-1
        else
            k=k-1
        end
    end
    local number m=starti
    while m<=last do
        chat_bubble_show(net_chat_uid(m),net_chat_text(m))
        m=m+1
    end
    chat_seen_key=lastkey
end
public function draw_chat_bubble_at(number x, number y, string msg, number t)
    if t<=0||str_len(msg)==0 then
        return
    end
    local number a=floor(clamp(t/chat_bubble_fade,0,1)*chat_bubble_alpha)
    if a<=0 then
        return
    end
    local color box=(((unsigned)(int)a)<<24)|0x00FFFFFF
    local number hw=25*cube_scale*player_scale
    local number bw=0, bh=0, bx=0, by=0, sc=0.5
    local string st=chat_sticker_tex(msg)
    if str_len(st)>0 then
        -- Стикеры показываем картинкой вместо текста «/sticker ...»
        bw=56
        bh=56
    else
        local number tw=text_ink_width(msg)*sc
        local number maxw=screen_w-24-2*chat_bubble_pad
        if tw>maxw then
            sc=sc*maxw/tw
            tw=maxw
        end
        bw=tw+2*chat_bubble_pad
        bh=chat_bubble_h
    end
    bx=clamp(x-bw/2,4,screen_w-bw-4)
    by=y-hw-bh-30
    if by<4 then
        by=4
    end
    roundrect(bx,by,bw,bh,10,box)
    if str_len(st)>0 then
        tex(bx+8,by+8,st,0,0.4)
        return
    end
    local color ink=(((unsigned)(int)a)<<24)|((unsigned)(int)chat_bubble_ink)
    text_in_box(msg,bx,by,bw,bh,ink,sc)
end
public function chat_bubbles_reset()
    bubble_msg0=""
    bubble_msg1=""
    bubble_msg2=""
    bubble_msg3=""
    bubble_t0=0
    bubble_t1=0
    bubble_t2=0
    bubble_t3=0
    chat_seen_key=""
end
public function draw_chat_bubbles()
    if net_slot()<0 then
        return
    end
    local number s=net_slot(), i=0
    while i<max_players do
        if i==s then
            draw_chat_bubble_at(player.x,player.y,bubble_msg(i),bubble_left(i))
        else
            local number b=i*remote_fields
            if arr_get(remotes,b+5)==1 then
                draw_chat_bubble_at(arr_get(remotes,b+1),arr_get(remotes,b+2),bubble_msg(i),bubble_left(i))
            end
        end
        i=i+1
    end
end
