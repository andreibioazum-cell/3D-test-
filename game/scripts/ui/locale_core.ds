function tr_hitboxes_toggle()
    if language == 1
        if show_hitboxes == 1
            return "Хитбоксы: ВКЛ"
        end
        return "Хитбоксы: ВЫКЛ"
    end
    if show_hitboxes == 1
        return "Hitboxes: ON"
    end
    return "Hitboxes: OFF"
end
// Зимняя тема одним тапом включает и выключает снежный фон арены и снегопад.
function tr_winter_toggle()
    if language == 1
        if winter_theme == 1
            return "Зимняя тема: ВКЛ"
        end
        return "Зимняя тема: ВЫКЛ"
    end
    if winter_theme == 1
        return "Winter theme: ON"
    end
    return "Winter theme: OFF"
end
// Счётчик FPS показывается только в бою (соло, онлайн и ивенты).
function tr_fps_meter_toggle()
    if language == 1
        if show_fps == 1
            return "FPS в бою: ВКЛ"
        end
        return "FPS в бою: ВЫКЛ"
    end
    if show_fps == 1
        return "Battle FPS: ON"
    end
    return "Battle FPS: OFF"
end
function tr_fps_label()
    if language == 1
        return "Частота кадров"
    end
    return "Frame rate"
end
function tr_fps_value()
    if fps_cap == 0
        if language == 1
            return "максимум"
        end
        return "max"
    end
    return fps_cap + " fps"
end
function tr_scale_label()
    if language == 1
        return "Апскейл"
    end
    return "Upscale"
end
function tr_scale_value()
    if render_scale == 1
        if language == 1
            return "выкл"
        end
        return "off"
    end
    if language == 1
        return "пиксели " + render_scale + "x"
    end
    return "pixels " + render_scale + "x"
end
