public function tr_quest_reward(number c, number cd)
    local string out = ""
    if language == 1 then
        out = "+" + c + " кубков, +" + cd + " леденцов"
    else
        out = "+" + c + " cups, +" + cd + " candies"
    end
    return out
end
public function tr_quest_next_in(number m)
    if language == 1 then
        return "Новое через " + m + " мин."
    end
    return "Next in " + m + " min"
end
