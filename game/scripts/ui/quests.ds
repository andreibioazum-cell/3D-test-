-- Задания: 3 активных, при выполнении появляется новое
-- Типы: 0 - выиграй соло, 1 - выиграй онлайн, 2 - собери леденцы, 3 - сыграй боев
public function quest_init()
    if arr_len(quest_type) >= quest_count then
        return
    end
    arr_clear(quest_type)
    arr_clear(quest_prog)
    arr_clear(quest_need)
    arr_clear(quest_next)
    local number i = 0
    while i < quest_count do
        local number t = rand() % 4
        local number need = 1
        if t == 0 then
            need = 1
        else if t == 1 then
            need = 1
        else if t == 2 then
            need = 5
        else
            need = 3
        end
        arr_push(quest_type, t)
        arr_push(quest_prog, 0)
        arr_push(quest_need, need)
        arr_push(quest_next, 0)
        i = i + 1
    end
    quest_save()
end
-- Состояние заданий (тип/прогресс/норма/метка появления следующего) хранится
-- нативно и переживает выход из игры; net_quest_now() — реальное время, поэтому
-- отсчёт «5 минут» идёт даже когда игра закрыта, а задания не сбрасываются.
public function quest_save()
    net_save_quest_state(
        arr_get(quest_type, 0), arr_get(quest_prog, 0), arr_get(quest_need, 0), arr_get(quest_next, 0),
        arr_get(quest_type, 1), arr_get(quest_prog, 1), arr_get(quest_need, 1), arr_get(quest_next, 1),
        arr_get(quest_type, 2), arr_get(quest_prog, 2), arr_get(quest_need, 2), arr_get(quest_next, 2))
end
public function quest_restore()
    arr_clear(quest_type)
    arr_clear(quest_prog)
    arr_clear(quest_need)
    arr_clear(quest_next)
    local number i = 0
    while i < quest_count do
        arr_push(quest_type, net_load_quest_state(i, 0))
        arr_push(quest_prog, net_load_quest_state(i, 1))
        arr_push(quest_need, net_load_quest_state(i, 2))
        arr_push(quest_next, net_load_quest_state(i, 3))
        i = i + 1
    end
end
public function quest_cooldown_left(number i)
    if arr_get(quest_type, i) != -1 then
        return 0
    end
    local number left = arr_get(quest_next, i) - net_quest_now()
    if left < 0 then
        return 0
    end
    return left
end
public function quest_load()
    -- Если есть сохранение — восстанавливаем задания целиком (тип/прогресс/
    -- норма/кулдаун), иначе создаём новые. Так задания НЕ сбрасываются при
    -- перезаходе, а кулдаун сохраняется.
    if net_quest_has_state() == 1 then
        quest_restore()
    else if arr_len(quest_type) < quest_count then
        quest_init()
    end
    -- Откатываем истёкшие кулдауны: если метка прошла — сразу новое задание.
    local number now = net_quest_now()
    local number i = 0
    while i < quest_count do
        if arr_get(quest_type, i) == -1 && arr_get(quest_next, i) > 0 && now >= arr_get(quest_next, i) then
            quest_roll_new(i)
            arr_set(quest_next, i, 0)
        end
        i = i + 1
    end
    quest_save()
end
-- Откатывает истёкшие кулдауны (зовётся из update): новое задание появляется
-- само, когда прошло quest_respawn реальных секунд.
public function quest_tick()
    local number now = net_quest_now()
    local number i = 0
    local number changed = 0
    while i < quest_count do
        if arr_get(quest_type, i) == -1 && arr_get(quest_next, i) > 0 && now >= arr_get(quest_next, i) then
            quest_roll_new(i)
            arr_set(quest_next, i, 0)
            changed = 1
        end
        i = i + 1
    end
    if changed == 1 then
        quest_save()
    end
end
public function quest_title(number t)
    if t == 0 then
        return tr_quest_win_solo()
    end
    if t == 1 then
        return tr_quest_win_online()
    end
    if t == 2 then
        return tr_quest_collect_candy()
    end
    return tr_quest_play_matches()
end
public function quest_progress_text(number i)
    if arr_get(quest_type, i) == -1 then
        return ""
    end
    local number p = arr_get(quest_prog, i)
    local number n = arr_get(quest_need, i)
    local string out = "" + p + "/" + n
    return out
end
public function quest_is_done(number i)
    if arr_get(quest_type, i) == -1 then
        return 0
    end
    local number p = arr_get(quest_prog, i)
    local number n = arr_get(quest_need, i)
    if p >= n then
        return 1
    end
    return 0
end
public function quest_roll_new(number idx)
    -- Новый рандомный квест на место выполненного
    local number t = rand() % 4
    local number need = 1
    if t == 0 then
        need = 1
    else if t == 1 then
        need = 1
    else if t == 2 then
        need = 5
    else
        need = 3
    end
    arr_set(quest_type, idx, t)
    arr_set(quest_prog, idx, 0)
    arr_set(quest_need, idx, need)
    ds_log("quest rolled new %g at %g", t, idx)
end
public function quest_complete(number idx)
    if quest_is_done(idx) == 0 then
        return
    end
    -- Награда (срезана: quest_cups / quest_candies)
    cups = cups + quest_cups
    candies = candies + quest_candies
    save_progress()
    quest_msg_t = msg_time
    ds_log("quest %g completed", idx)
    -- Следующее задание появляется не сразу, а через quest_respawn реальных
    -- секунд; слот уходит в кулдаун и отсчёт идёт даже при закрытой игре.
    arr_set(quest_type, idx, -1)
    arr_set(quest_prog, idx, 0)
    arr_set(quest_need, idx, 1)
    arr_set(quest_next, idx, net_quest_now() + quest_respawn)
    quest_save()
end
public function quest_on_win(number result)
    -- result 1 = победа, 2 = поражение
    -- Для всех активных квестов
    local number i = 0
    while i < quest_count do
        local number t = arr_get(quest_type, i)
        if quest_is_done(i) == 0 then
            if t == 0 && result == 1 && game_state == ST_SOLO then
                arr_set(quest_prog, i, arr_get(quest_prog, i) + 1)
            end
            if t == 1 && result == 1 && game_state == ST_ONLINE then
                arr_set(quest_prog, i, arr_get(quest_prog, i) + 1)
            end
            if t == 3 then
                -- сыграй боев - любой финиш
                arr_set(quest_prog, i, arr_get(quest_prog, i) + 1)
            end
            if quest_is_done(i) == 1 then
                quest_complete(i)
            end
        end
        i = i + 1
    end
    -- Сохраняем прогресс заданий после боя, чтобы он не сбрасывался при выходе.
    quest_save()
end
public function quest_on_candy()
    local number i = 0
    while i < quest_count do
        local number t = arr_get(quest_type, i)
        if t == 2 && quest_is_done(i) == 0 then
            arr_set(quest_prog, i, arr_get(quest_prog, i) + 1)
            if quest_is_done(i) == 1 then
                quest_complete(i)
            end
        end
        i = i + 1
    end
end
public function draw_quest_card(number i)
    local number x = quest_x()
    local number y = quest_row_y(i)
    local number w = quest_w()
    local number done = quest_is_done(i)
    local number locked = 0
    panel(x, y, w, ach_card_h, locked)
    local color c = panel_text(locked)
    local number t = arr_get(quest_type, i)
    if t == -1 then
        -- Слот в кулдауне: показываем, через сколько появится следующее.
        local number left = quest_cooldown_left(i)
        local number mins = floor(left / 60)
        if left - mins * 60 > 0 then
            mins = mins + 1
        end
        if mins < 1 then
            mins = 1
        end
        text_scaled(tr_quest_next_in(mins), x + card_text_pad, y + 14, c, 0.62)
        text_scaled("", x + card_text_pad, y + 46, c, 0.46)
        text_scaled("", x + card_text_pad, y + 70, c, 0.42)
        return
    end
    local string title = quest_title(t)
    local string prog = quest_progress_text(i)
    local string rew = tr_quest_reward(quest_cups, quest_candies)
    if done == 1 then
        rew = tr_achievement_open()
    end
    text_scaled(title, x + card_text_pad, y + 14, c, 0.62)
    text_scaled(prog, x + card_text_pad, y + 46, c, 0.46)
    text_scaled(rew, x + card_text_pad, y + 70, c, 0.42)
end
public function draw_quests()
    quest_load()
    screen_fill()
    ctext(tr_quests(), title_y(), text_color)
    local number i = 0
    while i < quest_count do
        draw_quest_card(i)
        i = i + 1
    end
    quest_msg_t = tick_down(quest_msg_t)
    draw_msg(tr_quest_reward(quest_cups, quest_candies), quest_row_y(quest_count) + 12, quest_msg_t)
    draw_back()
end
public function touch_quests(number x, number y, number action)
    if action != 0 then
        return
    end
    if back_hit(x, y) == 1 then
        start_transition(ST_LOBBY)
        return
    end
end
