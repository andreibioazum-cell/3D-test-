-- Задания: 3 активных, при выполнении появляется новое
-- Типы: 0 - выиграй соло, 1 - выиграй онлайн, 2 - собери леденцы, 3 - сыграй боев
public function quest_init()
    if arr_len(quest_type) >= quest_count then
        return
    end
    arr_clear(quest_type)
    arr_clear(quest_prog)
    arr_clear(quest_need)
    local number i = 0
    while i < quest_count do
        local number t = rand() % 4
        local number need = 1
        if t == 0 then
            need = 1
        else if t == 1 then
            need = 1
        else if t == 2 then
            need = 5
        else
            need = 3
        end
        arr_push(quest_type, t)
        arr_push(quest_prog, 0)
        arr_push(quest_need, need)
        i = i + 1
    end
    quest_save()
end
public function quest_save()
    -- Сохраняем в файл quests.dat через нативную часть? Пока через net_save_playtime не подходит, сделаем через отдельный файл нативно?
    -- Для простоты сохраним в progress как часть? Пока пишем в отдельный файл через ds_log и нативно сделаем позже.
    -- Используем net_save_playtime как заглушку? Нет, сделаем через promo.dat логику но пока через файл quests.dat напрямую в C нет функции.
    -- Поэтому сохраняем через обычные файлы используя существующий механизм: запишем в файл quests.dat через нативную функцию которую добавим?
    -- Пока просто храним в памяти и в playtime файле как часть? Для MVP - сохраняем через net_save_playtime? Нет.
    -- Сделаем через native: добавим quest_save/load в playtime.inc позже. Сейчас просто в памяти.
    local number i = 0
    local string txt = ""
    while i < quest_count do
        local number t = arr_get(quest_type, i)
        local number p = arr_get(quest_prog, i)
        local number n = arr_get(quest_need, i)
        -- Для сохранения используем ds_log, а нативно будем читать quests.dat
        -- Пока вызываем net_save_playtime для триггера? Нет.
        i = i + 1
    end
end
public function quest_load()
    -- Загрузка из памяти - если пусто, инициализируем
    if arr_len(quest_type) < quest_count then
        quest_init()
    end
end
public function quest_title(number t)
    if t == 0 then
        return tr_quest_win_solo()
    end
    if t == 1 then
        return tr_quest_win_online()
    end
    if t == 2 then
        return tr_quest_collect_candy()
    end
    return tr_quest_play_matches()
end
public function quest_progress_text(number i)
    local number p = arr_get(quest_prog, i)
    local number n = arr_get(quest_need, i)
    local string out = "" + p + "/" + n
    return out
end
public function quest_is_done(number i)
    local number p = arr_get(quest_prog, i)
    local number n = arr_get(quest_need, i)
    if p >= n then
        return 1
    end
    return 0
end
public function quest_roll_new(number idx)
    -- Новый рандомный квест на место выполненного
    local number t = rand() % 4
    local number need = 1
    if t == 0 then
        need = 1
    else if t == 1 then
        need = 1
    else if t == 2 then
        need = 5
    else
        need = 3
    end
    arr_set(quest_type, idx, t)
    arr_set(quest_prog, idx, 0)
    arr_set(quest_need, idx, need)
    ds_log("quest rolled new %g at %g", t, idx)
end
public function quest_complete(number idx)
    if quest_is_done(idx) == 0 then
        return
    end
    -- Награда
    cups = cups + 15
    candies = candies + 5
    save_progress()
    quest_msg_t = msg_time
    ds_log("quest %g completed", idx)
    quest_roll_new(idx)
    quest_save()
end
public function quest_on_win(number result)
    -- result 1 = победа, 2 = поражение
    -- Для всех активных квестов
    local number i = 0
    while i < quest_count do
        local number t = arr_get(quest_type, i)
        if quest_is_done(i) == 0 then
            if t == 0 && result == 1 && game_state == ST_SOLO then
                arr_set(quest_prog, i, arr_get(quest_prog, i) + 1)
            end
            if t == 1 && result == 1 && game_state == ST_ONLINE then
                arr_set(quest_prog, i, arr_get(quest_prog, i) + 1)
            end
            if t == 3 then
                -- сыграй боев - любой финиш
                arr_set(quest_prog, i, arr_get(quest_prog, i) + 1)
            end
            if quest_is_done(i) == 1 then
                quest_complete(i)
            end
        end
        i = i + 1
    end
end
public function quest_on_candy()
    local number i = 0
    while i < quest_count do
        local number t = arr_get(quest_type, i)
        if t == 2 && quest_is_done(i) == 0 then
            arr_set(quest_prog, i, arr_get(quest_prog, i) + 1)
            if quest_is_done(i) == 1 then
                quest_complete(i)
            end
        end
        i = i + 1
    end
end
public function draw_quest_card(number i)
    local number x = quest_x()
    local number y = quest_row_y(i)
    local number w = quest_w()
    local number done = quest_is_done(i)
    local number locked = 0
    if done == 1 then
        locked = 0
    end
    panel(x, y, w, ach_card_h, locked)
    local color c = panel_text(locked)
    local number t = arr_get(quest_type, i)
    local string title = quest_title(t)
    local string prog = quest_progress_text(i)
    local string rew = tr_quest_reward(15, 5)
    if done == 1 then
        rew = tr_achievement_open()
    end
    text_scaled(title, x + card_text_pad, y + 14, c, 0.62)
    text_scaled(prog, x + card_text_pad, y + 46, c, 0.46)
    text_scaled(rew, x + card_text_pad, y + 70, c, 0.42)
end
public function draw_quests()
    quest_load()
    screen_fill()
    ctext(tr_quests(), title_y(), text_color)
    local number i = 0
    while i < quest_count do
        draw_quest_card(i)
        i = i + 1
    end
    quest_msg_t = tick_down(quest_msg_t)
    draw_msg(tr_quest_reward(15,5), quest_row_y(quest_count) + 12, quest_msg_t)
    draw_back()
end
public function touch_quests(number x, number y, number action)
    if action != 0 then
        return
    end
    if back_hit(x, y) == 1 then
        start_transition(ST_LOBBY)
        return
    end
end
