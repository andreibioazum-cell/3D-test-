include graphics
// Задания: 3 активных, при выполнении появляется новое
// Типы: 0 - выиграй соло, 1 - выиграй онлайн, 2 - собери леденцы, 3 - сыграй боев
// Сложность повышена, награда урезана
number quest_prev_state=0
function quest_need_for(number t)
    if t == 0
        return 3
    end
    if t == 1
        return 3
    end
    if t == 2
        return 12
    end
    return 7
end
function quest_init()
    if arr_len(quest_type) >= quest_count
        return
    end
    arr_clear(quest_type)
    arr_clear(quest_prog)
    arr_clear(quest_need)
    number i = 0
    loop i < quest_count
        number t = rand() % 4
        // стараемся не дублировать типы внутри тройки
        number tries = 0
        loop tries < 8
            number dup = 0, k = 0
            loop k < i
                if arr_get(quest_type, k) == t
                    dup = 1
                end
                k = k + 1
            end
            if dup == 0
                tries = 8
            else
                t = rand() % 4
                tries = tries + 1
            end
        end
        arr_push(quest_type, t)
        arr_push(quest_prog, 0)
        arr_push(quest_need, quest_need_for(t))
        i = i + 1
    end
    quest_save()
end
function quest_save()
    number i = 0
    string txt = ""
    loop i < quest_count
        number t = arr_get(quest_type, i)
        number p = arr_get(quest_prog, i)
        number n = arr_get(quest_need, i)
        i = i + 1
    end
end
function quest_load()
    if arr_len(quest_type) < quest_count
        quest_init()
    end
end
function quest_title(number t)
    if t == 0
        return tr_quest_win_solo()
    end
    if t == 1
        return tr_quest_win_online()
    end
    if t == 2
        return tr_quest_collect_candy()
    end
    return tr_quest_play_matches()
end
function quest_progress_text(number i)
    number p = arr_get(quest_prog, i)
    number n = arr_get(quest_need, i)
    string out = "" + p + "/" + n
    return out
end
function quest_is_done(number i)
    number p = arr_get(quest_prog, i)
    number n = arr_get(quest_need, i)
    if p >= n
        return 1
    end
    return 0
end
function quest_roll_new(number idx)
    number old = arr_get(quest_type, idx)
    number t = rand() % 4
    number tries = 0
    loop tries < 12
        if t != old
            number dup = 0, k = 0
            loop k < quest_count
                if k != idx && arr_get(quest_type, k) == t
                    dup = 1
                end
                k = k + 1
            end
            if dup == 0
                tries = 12
            else
                t = rand() % 4
                tries = tries + 1
            end
        else
            t = rand() % 4
            tries = tries + 1
        end
    end
    // на случай если не нашли уникальный — оставляем как есть, но хотя бы отличающийся от старого
    if t == old
        t = old + 1
        if t >= 4
            t = 0
        end
    end
    arr_set(quest_type, idx, t)
    arr_set(quest_prog, idx, 0)
    arr_set(quest_need, idx, quest_need_for(t))
    ds_log("quest rolled new %g at %g need %g", t, idx, quest_need_for(t))
end
function quest_complete(number idx)
    if quest_is_done(idx) == 0
        return
    end
    cups = cups + quest_reward_cups
    candies = candies + quest_reward_candies
    save_progress()
    // убрали оповещение внизу, но оставляем лог
    ds_log("quest %g completed +%g cups +%g candies", idx, quest_reward_cups, quest_reward_candies)
    quest_roll_new(idx)
    quest_save()
end
function quest_on_win(number result)
    number i = 0
    loop i < quest_count
        if quest_is_done(i) == 0
            number t = arr_get(quest_type, i)
            number inc = 0
            if t == 0 && result == 1 && game_state == ST_SOLO
                inc = 1
            end
            if t == 1 && result == 1 && game_state == ST_ONLINE
                inc = 1
            end
            if t == 3
                inc = 1
            end
            if inc == 1
                arr_set(quest_prog, i, arr_get(quest_prog, i) + 1)
                if quest_is_done(i) == 1
                    quest_complete(i)
                end
            end
        end
        i = i + 1
    end
end
function quest_on_candy()
    number i = 0
    loop i < quest_count
        number t = arr_get(quest_type, i)
        if t == 2 && quest_is_done(i) == 0
            arr_set(quest_prog, i, arr_get(quest_prog, i) + 1)
            if quest_is_done(i) == 1
                quest_complete(i)
            end
        end
        i = i + 1
    end
end
function draw_quest_card(number i)
    number x = quest_x()
    number y = quest_row_y(i)
    number w = quest_w()
    number done = quest_is_done(i)
    number locked = 0
    panel(x, y, w, ach_card_h, locked)
    color c = panel_text(locked)
    number t = arr_get(quest_type, i)
    string title = quest_title(t)
    string prog = quest_progress_text(i)
    string rew = tr_quest_reward(quest_reward_cups, quest_reward_candies)
    text_scaled(title, x + card_text_pad, y + 14, c, 0.62)
    text_scaled(prog, x + card_text_pad, y + 46, c, 0.46)
    text_scaled(rew, x + card_text_pad, y + 70, c, 0.42)
end
function draw_quests()
    quest_load()
    screen_fill()
    ctext(tr_quests(), title_y(), text_color)
    number i = 0
    loop i < quest_count
        draw_quest_card(i)
        i = i + 1
    end
    draw_back()
end
function touch_quests(number x, number y, number action)
    if action != 0
        return
    end
    if back_hit(x, y) == 1
        if quest_prev_state == ST_LOBBY
            start_transition(ST_LOBBY)
        else
            start_transition(ST_MODES)
        end
        return
    end
end
