include graphics
function bp_reward_text(number n)
    if n == 1
        return tr_bp_reward1()
    end
    if n == 2
        return tr_bp_reward2()
    end
    if n == 3
        return tr_bp_reward3()
    end
    if n == 4
        return tr_bp_reward4()
    end
    return tr_bp_reward5()
end
function bp_status_text(number n)
    number bp_lv = net_load_bp_level()
    if n <= bp_lv
        return tr_bp_bought()
    end
    if n == bp_lv + 1
        return tr_bp_buy()
    end
    return tr_bp_locked()
end
function bp_buy_level(number n)
    number bp_lv = net_load_bp_level()
    if n != bp_lv + 1
        bp_msg_kind = 1
        bp_msg_t = msg_time
        return 0
    end
    if cups < bp_cost
        bp_msg_kind = 0
        bp_msg_t = msg_time
        return 0
    end
    cups = cups - bp_cost
    number new_lv = n
    if new_lv < 0
        new_lv = 0
    end
    if new_lv > bp_max
        new_lv = bp_max
    end
    // Сохраняем через прогресс: bp_level это поле в progress.dat
    // progress_from_storage читает его через net_load_bp_level, а save_progress пишет через net_save_progress_all
    // Для простоты - напрямую вызываем сохранение с новым bp
    // Получаем остальные поля из текущего прогресса
    number ol = class_level_of(CLASS_ORDINARY)
    number ou = class_unlocked_of(CLASS_ORDINARY)
    number al = class_level_of(CLASS_AZUM)
    number au = class_unlocked_of(CLASS_AZUM)
    number sl = class_level_of(CLASS_SANTA)
    number su = class_unlocked_of(CLASS_SANTA)
    number el = class_level_of(CLASS_EBUC)
    number eu = class_unlocked_of(CLASS_EBUC)
    net_save_progress_all(cups, candies, player_class, class_owned_of(CLASS_AZUM), class_owned_of(CLASS_SANTA), class_owned_of(CLASS_EBUC), player_level, levels_unlocked, ol, ou, al, au, sl, su, el, eu, new_lv, azum_skin)
    // Выдаем награды
    if n == 1
        // Обычный 3 уровень
        set_class_progress(CLASS_ORDINARY, 3, 3)
        sync_selected_class()
        save_progress()
    end
    if n == 2
        // Скин зомби
        azum_skin = SKIN_ZOMBIE
        grant_achievement(ACH_LEGENDS)
        save_progress()
    end
    if n == 3
        candies = candies + 50
        save_progress()
    end
    if n == 4
        cups = cups + 100
        save_progress()
    end
    if n == 5
        cups = cups + 150
        candies = candies + 50
        save_progress()
    end
    bp_msg_t = 0
    ds_log("bp bought %g", n)
    return 1
end
function bp_action(number n)
    number bp_lv = net_load_bp_level()
    if n <= bp_lv
        return
    end
    bp_buy_level(n)
end
function draw_bp_row(number n)
    number x = bp_x()
    number w = bp_w()
    number y = bp_row_y(n)
    number bp_lv = net_load_bp_level()
    number selected = 0
    if n <= bp_lv
        selected = 1
    end
    number locked = 0
    if n > bp_lv + 1
        locked = 1
    end
    card_state(x, y, w, level_row_h, selected, locked)
    centered_text(tr_level() + " " + n, x, w, y + 10, panel_text(locked), 0.62)
    centered_text(bp_reward_text(n), x, w, y + 34, panel_text(locked), 0.46)
    centered_text(bp_status_text(n), x, w, y + 52, panel_text(locked), 0.42)
end
function draw_battlepass()
    screen_fill()
    ctext(tr_battlepass(), title_y(), text_color)
    number n = 1
    loop n <= bp_max
        draw_bp_row(n)
        n = n + 1
    end
    bp_msg_t = tick_down(bp_msg_t)
    string msg = ""
    if bp_msg_kind == 1
        msg = tr_level_locked()
    else
        msg = tr_level_need_cups()
    end
    draw_msg(msg, bp_msg_y(), bp_msg_t)
    draw_back()
end
function touch_battlepass(number x, number y, number action)
    if action != 0
        return
    end
    if back_hit(x, y) == 1
        start_transition(ST_LOBBY)
        return
    end
    number n = 1
    loop n <= bp_max
        if hit_bp_row(x, y, n) == 1
            bp_action(n)
            return
        end
        n = n + 1
    end
end
