public function dust_spawn(number px, number py, number jdx, number jdy)
    local number i = 0, base = 0, found = 0
    while i < dust_max do
        base = i * dust_fields
        if arr_get(dust, base + 4) <= 0 then
            found = 1
            i = dust_max
        end
        i = i + 1
    end
    if found == 0 then
        return
    end
    local number angle = (rand() % 628) / 100.0
    local number vx = cos(angle) * dust_spd * dust_side_share - jdx * dust_spd * dust_back_share
    local number vy = sin(angle) * dust_spd * dust_side_share - jdy * dust_spd * dust_back_share
    arr_set(dust, base, px)
    arr_set(dust, base + 1, py)
    arr_set(dust, base + 2, vx)
    arr_set(dust, base + 3, vy)
    arr_set(dust, base + 4, dust_life_max)
end
public function update_dust()
    local number i = 0, base = 0
    while i < dust_max do
        base = i * dust_fields
        local number lf = arr_get(dust, base + 4)
        if lf > 0 then
            arr_set(dust, base, arr_get(dust, base) + arr_get(dust, base + 2) * dt)
            arr_set(dust, base + 1, arr_get(dust, base + 1) + arr_get(dust, base + 3) * dt)
            arr_set(dust, base + 2, arr_get(dust, base + 2) * 0.88)
            arr_set(dust, base + 3, arr_get(dust, base + 3) * 0.88)
            arr_set(dust, base + 4, lf - dt)
        end
        i = i + 1
    end
end
public function draw_dust()
    local number i = 0, base = 0
    while i < dust_max do
        base = i * dust_fields
        local number lf = arr_get(dust, base + 4)
        if lf > 0 then
            local number t = lf / dust_life_max
            local number fade = clamp(t / 0.5, 0, 1)
            local number r = dust_r_max * (0.45 + 0.55 * fade)
            local number a = floor(fade * fade * 150)
            if a > 0 then
                local number grey = floor(120 + 100 * t)
                local number c = ((((unsigned)(int)a) << 24) | (((unsigned)(int)grey) << 16) | (((unsigned)(int)grey) << 8) | ((unsigned)(int)grey))
                circle(arr_get(dust, base), arr_get(dust, base + 1), r, c)
            end
        end
        i = i + 1
    end
end
public function dust_trail(number px, number py, number jdx, number jdy)
    dust_spawn(px, py, jdx, jdy)
    if rand() % 2 == 0 then
        dust_spawn(px - jdx * dust_back_off * 0.4, py - jdy * dust_back_off * 0.4, jdx, jdy)
    end
end
public function tick_dust(number jdx, number jdy, number jmag)
    if finished != 0 then
        return
    end
    if jmag < 0.18 then
        return
    end
    if dust_cd > 0 then
        dust_cd = dust_cd - dt
        return
    end
    dust_cd = dust_spawn_cd
    dust_trail(player.x - jdx * dust_back_off, player.y - jdy * dust_back_off, jdx, jdy)
end
public function tick_enemy_dust(number vx, number vy)
    if finished != 0 || enemy.hp <= 0 then
        return
    end
    local number mag = sqrt(vx*vx + vy*vy)
    if mag < dust_enemy_min_speed then
        return
    end
    if enemy_dust_cd > 0 then
        enemy_dust_cd = enemy_dust_cd - dt
        return
    end
    enemy_dust_cd = dust_spawn_cd
    local number dx = vx / mag, dy = vy / mag
    dust_trail(enemy.x - dx * dust_back_off, enemy.y - dy * dust_back_off, dx, dy)
end
public function tick_remote_dust(number s, number x, number y, number tx, number ty)
    if finished != 0 then
        return
    end
    local number vdx = tx - x, vdy = ty - y
    local number est = sqrt(vdx*vdx + vdy*vdy) * remote_smooth
    if est < dust_enemy_min_speed || est > 900 then
        return
    end
    if arr_get(remote_dust_cd, s) > 0 then
        arr_set(remote_dust_cd, s, arr_get(remote_dust_cd, s) - dt)
        return
    end
    arr_set(remote_dust_cd, s, dust_spawn_cd)
    local number dl = sqrt(vdx*vdx + vdy*vdy)
    local number dx = vdx / dl, dy = vdy / dl
    dust_trail(x - dx * dust_back_off, y - dy * dust_back_off, dx, dy)
end
