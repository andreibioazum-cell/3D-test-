include graphics
function start_transition(number target)
    if t_dir != 0
        return
    end
    t_target = target
    t_dir = 1
end
function leave_screen(number state)
    if state == ST_LOGIN || state == ST_PROMO
        keyboard_hide()
    end
    if state == ST_ONLINE
        chat_set_open(0)
        net_disconnect()
        event_mode = 0
        event_t = 0
    end
    if state == ST_SOLO || state == ST_ONLINE
        save_progress()
    end
end
function enter_screen(number state)
    if state == ST_SOLO
        init_game()
        return 1
    end
    if state == ST_LOGIN
        login_open()
        return 1
    end
    if state == ST_QUESTS
        quest_load()
        return 1
    end
    if state == ST_LEADERBOARD
        open_leaderboard()
        return 1
    end
    if state == ST_ONLINE
        if net_is_banned(net_login_nick()) == 1
            banned_msg = tr_banned()
            game_state = ST_LOBBY
            t_dir = -1
            t_fade = 1
            return 0
        end
        init_online()
    end
    return 1
end
function update_transition()
    if t_dir == 1
        t_fade = t_fade + dt / transition_duration
        if t_fade >= 1
            t_fade = 1
            t_dir = 2
        end
        return
    end
    if t_dir == 2
        leave_screen(game_state)
        game_state = t_target
        if enter_screen(t_target) == 1
            t_dir = -1
        end
        return
    end
    if t_dir == -1
        t_fade = t_fade - dt / transition_duration
        if t_fade <= 0
            t_fade = 0
            t_dir = 0
        end
    end
end
function load_textures()
    png_load(GRASS)
    snow_tex_ok = 0
    if candy_enabled == 1
        snow_tex_ok = png_load(SNOW_TEX)
    end
    png_load(ORDINARY_TEX)
    png_load(PUNCH_TEX)
    azum_tex_ok = png_load(AZUM_TEX)
    png_load(AZUM_PUNCH_TEX)
    azum_zombie_tex_ok = png_load(AZUM_ZOMBIE_TEX)
    azum_zombie_punch_tex_ok = png_load(AZUM_ZOMBIE_PUNCH_TEX)
    png_load(SANTA_TEX)
    png_load(SANTA_PUNCH_TEX)
    png_load(EBUC_TEX)
    png_load(EBUC_PUNCH_TEX)
    png_load(DESPENSER_TEX)
    png_load(CANDY_TEX)
    png_load(SNOWFLAKE_TEX)
end
function start_music()
    music_ok = snd_load(LOBBY_MUSIC)
    if music_ok == 0
        ds_log("init: no lobby music")
        return
    end
    music_level = 1
    snd_volume(LOBBY_MUSIC, music_volume / 100)
    snd_loop(LOBBY_MUSIC)
    ds_log("init: lobby music on")
end
function init()
    ds_log("init: loading textures")
    load_textures()
    net_set_firebase_key(FB_KEY)
    net_autologin(FIREBASE)
    start_music()
    progress_from_storage()
    settings_from_storage()
    apply_video_settings()
    ds_log("init: ready")
end
function update_music()
    if music_ok == 0
        return
    end
    if game_state == ST_SOLO || game_state == ST_ONLINE
        music_level = clamp(music_level - dt / music_fade_out_time, 0, 1)
        snd_volume(LOBBY_MUSIC, music_volume / 100 * music_level)
        if music_level <= 0 && snd_playing(LOBBY_MUSIC) == 1
            snd_stop(LOBBY_MUSIC)
        end
        return
    end
    if snd_playing(LOBBY_MUSIC) == 0
        music_level = 0
        snd_loop(LOBBY_MUSIC)
    end
    music_level = clamp(music_level + dt / music_fade_in_time, 0, 1)
    snd_volume(LOBBY_MUSIC, music_volume / 100 * music_level)
end
function update_warning()
    if warn_open != 1
        return
    end
    warn_t = warn_t + dt
    if warn_t <= warn_hold
        warn_a = 1
        return
    end
    warn_a = 1 - (warn_t - warn_hold) / warn_fade
    if warn_a <= 0
        warn_a = 0
        warn_open = 0
        studio_open = 1
        studio_t = 0
        studio_a = 0
        studio_bg_a = 1
    end
end
function update_studio()
    if studio_open != 1
        return
    end
    studio_t = studio_t + dt
    if studio_t < studio_in
        studio_a = studio_t / studio_in
        return
    end
    if studio_t <= studio_in + studio_hold
        studio_a = 1
        studio_bg_a = 1
        return
    end
    studio_a = 1 - (studio_t - studio_in - studio_hold) / studio_fade
    studio_bg_a = studio_a
    if studio_a <= 0
        studio_a = 0
        studio_bg_a = 0
        studio_open = 0
    end
end
function tick_achievement_toast()
    ach_toast_t = tick_down(ach_toast_t)
end
function achievement_toast_text()
    if ach_toast_bit == ACH_FIRST_WIN
        return tr_achievement_first_win()
    end
    if ach_toast_bit == ACH_ALL_CHARACTERS
        return tr_achievement_grass()
    end
    return tr_achievement_legends()
end
function draw_achievement_toast()
    if ach_toast_bit <= 0 || ach_toast_t <= 0
        return
    end
    number elapsed = ACH_TOAST_DURATION - ach_toast_t
    number w = fit_w(460)
    number h = 70
    number x = center_x(w)
    number home_y = 64
    number off = home_y + h + 8
    number y = home_y
    if elapsed < ACH_TOAST_FADE_IN
        number k = elapsed / ACH_TOAST_FADE_IN
        number ease = 1 - (1 - k) * (1 - k)
        y = home_y - off * (1 - ease)
    else if elapsed > ACH_TOAST_FADE_IN + ACH_TOAST_HOLD
        number k2 = (elapsed - ACH_TOAST_FADE_IN - ACH_TOAST_HOLD) / ACH_TOAST_EXIT
        y = home_y - off * clamp(k2, 0, 1) * clamp(k2, 0, 1)
    end
    if y + h <= 0
        return
    end
    roundrect(x, y, w, h, btn_radius, ui_purple)
    string head = tr_achievement_toast_title()
    string body = achievement_toast_text()
    number hs = 0.42, bs = 0.62, gap = 6
    number hh = text_ink_height(head) * hs, ht = text_ink_top(head) * hs
    number bh = text_ink_height(body) * bs, bt = text_ink_top(body) * bs
    number top = y + (h - hh - gap - bh) / 2
    ctext_scaled(head, top - ht, text_color, hs)
    ctext_scaled(body, top + hh + gap - bt, text_color, bs)
end
function update()
    update_warning()
    update_studio()
    update_transition()
    update_music()
    tick_achievement_toast()
    if game_state == ST_SOLO
        update_game()
    else if game_state == ST_ONLINE
        update_online()
    else if game_state == ST_LOGIN
        update_login()
    else if game_state == ST_PROMO
        update_promo()
    end
    update_weather()
end
function draw_screen()
    if game_state == ST_LOBBY
        draw_lobby()
    else if game_state == ST_SOLO
        draw_game()
    else if game_state == ST_MODES
        draw_modes()
    else if game_state == ST_SETTINGS
        draw_settings()
    else if game_state == ST_LOGIN
        draw_login()
    else if game_state == ST_CLASSES
        draw_classes()
    else if game_state == ST_LEVELS
        draw_levels()
    else if game_state == ST_SKINS
        draw_skins()
    else if game_state == ST_LEADERBOARD
        draw_leaderboard()
    else if game_state == ST_ACHIEVEMENTS
        draw_achievements()
    else if game_state == ST_PROMO
        draw_promo()
    else if game_state == ST_QUESTS
        draw_quests()
    else
        draw_online()
    end
end
function draw()
    if t_fade >= 1
        rect(0, 0, screen_w, screen_h, 0xFF000000)
    else
        draw_screen()
        if t_fade > 0
            rect(0, 0, screen_w, screen_h, (1 + floor(t_fade * 254)) * 0x1000000)
        end
    end
    if warn_open == 1
        draw_warning()
    end
    if studio_open == 1
        draw_studio()
    end
    draw_achievement_toast()
end
function back_pressed()
    if warn_open == 1 || studio_open == 1
        return 1
    end
    if t_dir != 0
        return 1
    end
    if game_state == ST_ONLINE && chat_open == 1
        chat_set_open(0)
        return 1
    end
    if game_state == ST_SOLO || game_state == ST_ONLINE
        if finished != 0 && finish_t < alert_hold
            return 1
        end
        start_transition(ST_LOBBY)
        return 1
    end
    if game_state == ST_LEVELS || game_state == ST_SKINS
        start_transition(ST_CLASSES)
        return 1
    end
    if game_state == ST_LEADERBOARD || game_state == ST_PROMO
        start_transition(ST_MODES)
        return 1
    end
    if game_state == ST_QUESTS
        if quest_prev_state == ST_LOBBY
            start_transition(ST_LOBBY)
        else
            start_transition(ST_MODES)
        end
        return 1
    end
    if game_state == ST_LOGIN
        keyboard_hide()
        keyboard_clear()
        if login_after == ST_ONLINE
            start_transition(ST_MODES)
        else
            start_transition(ST_LOBBY)
        end
        return 1
    end
    if game_state != ST_LOBBY
        start_transition(ST_LOBBY)
        return 1
    end
    return 0
end
function touch(number x, number y, number action, number id)
    if t_dir != 0
        return
    end
    if warn_open == 1 || studio_open == 1
        return
    end
    if game_state == ST_LOBBY
        touch_lobby(x, y, action)
    else if game_state == ST_SOLO || game_state == ST_ONLINE
        touch_game(x, y, action, id)
    else
        touch_menu(x, y, action)
    end
end
