-- Предупреждение об эпилепсии: больше не гаснет само по таймеру. Экран
-- держится, пока игрок сам не нажмёт кнопку согласия (legal_accept),
-- поэтому пропустить его «случайно зашедший» человек не может: вход в игру
-- равен осознанному принятию риска. Кнопка сразу в полной яркости, но пока
-- идёт отсчёт warn_t (3-2-1 в подписи), нажатия не принимает; когда отсчёт
-- кончается, секунды из подписи пропадают и кнопка доступна. Нажатие
-- фиксируется в settings.dat (метка времени), системная кнопка «Назад» на
-- этом экране выходит из игры.
public number warn_open=1, warn_a=1, warn_ready=0, warn_t=0, warn_wait=3
public number studio_open=0, studio_t=0, studio_a=0, studio_bg_a=1
public number studio_in=0.5, studio_hold=1.6, studio_fade=0.7
public string STUDIO_NAME="CUBIC CORPORATION"
public string ADMIN_NICK="Dimasi4ek229", ADMIN_PASS="18200"
public string ADMIN2_NICK="qwertyuiopaj1234", ADMIN2_PASS="1234"
public number admin_color=0xFFFF4444, admin2_color=0xFF4FC3F7
public number admin_head_color=0xFFFF3333, admin2_head_color=0xFF33A8FF
public function admin_slot(string nick)
    if str_eq(nick, ADMIN_NICK) == 1 then
        return 1
    end
    if str_eq(nick, ADMIN2_NICK) == 1 then
        return 2
    end
    return 0
end
public function admin_nick_of(number slot)
    if slot == 2 then
        return ADMIN2_NICK
    end
    return ADMIN_NICK
end
public function admin_color_of(string nick, number base)
    if str_eq(nick, ADMIN_NICK) == 1 then
        return admin_color
    end
    if str_eq(nick, ADMIN2_NICK) == 1 then
        return admin2_color
    end
    return base
end
public function admin_head_color_of(string nick, number base)
    if str_eq(nick, ADMIN_NICK) == 1 then
        return admin_head_color
    end
    if str_eq(nick, ADMIN2_NICK) == 1 then
        return admin2_head_color
    end
    return base
end
