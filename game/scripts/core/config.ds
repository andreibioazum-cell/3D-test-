number admin_color=0xFFFF4444, admin2_color=0xFF4FC3F7
number admin_head_color=0xFFFF3333, admin2_head_color=0xFF33A8FF
function admin_slot(string nick)
    if str_eq(nick, ADMIN_NICK) == 1
        return 1
    end
    if str_eq(nick, ADMIN2_NICK) == 1
        return 2
    end
    return 0
end
function admin_nick_of(number slot)
    if slot == 2
        return ADMIN2_NICK
    end
    return ADMIN_NICK
end
function admin_color_of(string nick, number base)
    if str_eq(nick, ADMIN_NICK) == 1
        return admin_color
    end
    if str_eq(nick, ADMIN2_NICK) == 1
        return admin2_color
    end
    return base
end
function admin_head_color_of(string nick, number base)
    if str_eq(nick, ADMIN_NICK) == 1
        return admin_head_color
    end
    if str_eq(nick, ADMIN2_NICK) == 1
        return admin2_head_color
    end
    return base
end
