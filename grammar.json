{
  "scopeName": "source.dimscript",
  "name": "DimScript",
  "fileTypes": ["ds"],
  "patterns": [
    {
      "name": "comment.line.double-slash.dimscript",
      "match": "//.*$"
    },
    {
      "name": "storage.type.dimscript",
      "match": "\\b(num|number|str|string|col|color|arr|array)\\b"
    },
    {
      "name": "keyword.control.dimscript",
      "match": "\\b(object|function|if|else|loop|end|return|new|include|import)\\b"
    },
    {
      "name": "support.variable.engine.dimscript",
      "match": "\\b(screen_w|screen_h|dt|joy|mouse_clicked)\\b"
    },
    {
      "name": "support.function.builtin.dimscript",
      "match": "\\b(rect|roundrect|circle|ring|line|tex|tex_tint|png_load|text|text_scaled|text_width|text_height|text_ink_width|text_ink_height|clear_screen|window_create|game_run|mouse_x|mouse_y|particles_spawn|sound_play|snd_play|sqrt|sin|cos|atan2|floor|rand|console_count|console_line|console_type|console_clear|cam3d|cube3d|cube3d_yaw|line3d|flush3d|ds_log)\\b"
    },
    {
      "name": "entity.name.function.dimscript",
      "match": "\\bfunction\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": {"name": "entity.name.function.dimscript"}
      }
    },
    {
      "name": "entity.name.type.object.dimscript",
      "match": "\\bobject\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": {"name": "entity.name.type.object.dimscript"}
      }
    },
    {
      "name": "string.quoted.double.dimscript",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.dimscript",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "constant.numeric.dimscript",
      "match": "\\b(?:0[xX][0-9a-fA-F]+|\\d+(?:\\.\\d+)?)\\b"
    },
    {
      "name": "variable.other.dimscript",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    }
  ]
}
